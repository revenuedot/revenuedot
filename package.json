{
  "name": "revenuedot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "scripts": {
    "dev": "pnpm --filter @revenuedot/server dev",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "migrate": "tsx scripts/migrate.ts",
    "deploy:cloud": "bash scripts/deploy-cloud.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "packageExtensions": {
      "agents@0.24.0": {
        "dependencies": {
          "@modelcontextprotocol/sdk": "1.30.0",
          "@modelcontextprotocol/client": "2.0.0"
        }
      }
    }
  },
  "engines": {
    "node": ">=24"
  }
}
