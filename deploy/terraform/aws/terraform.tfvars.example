# Copy to terraform.tfvars and edit. Never commit terraform.tfvars or the state: they hold secrets.
name            = "revenuedot"
region          = "us-east-1"
domain_name     = "revenuedot.example.com"
route53_zone_id = "Z0123456789ABCDEFGHIJ"
image           = "ghcr.io/revenuedot/revenuedot:2026.10.03" # a date or commit tag of the published image, or your ECR copy
alarm_email     = "oncall@example.com"

# Optional
# environment = { REVENUEDOT_MAIL_FROM = "RevenueDot <no-reply@example.com>" }
# secret_arns = {
#   REVENUEDOT_SMTP_URL    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:revenuedot/smtp-url-AbCdEf"
#   REVENUEDOT_SIGNING_KEY = "arn:aws:secretsmanager:us-east-1:123456789012:secret:revenuedot/signing-key-AbCdEf"
# }
