# Copy to terraform.tfvars and edit. Never commit terraform.tfvars or the state: they hold secrets.
project_id  = "my-project"
region      = "us-central1"
image       = "us-central1-docker.pkg.dev/my-project/revenuedot/revenuedot:2026.10.03" # ghcr.io/revenuedot/revenuedot:<tag>, copied to Artifact Registry
alert_email = "oncall@example.com"

# Optional
# public_url = "https://revenuedot.example.com"
# environment = { REVENUEDOT_MAIL_FROM = "RevenueDot <no-reply@example.com>" }
# secret_ids  = { REVENUEDOT_SMTP_URL = "revenuedot-smtp-url" }
