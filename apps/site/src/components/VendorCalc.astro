---
// A slider calculator for one vendor's published rule next to RevenueDot Pro, in the style of the RevenueCat fee
// calculator (/tools/revenuecat-fee-calculator). The RevenueDot rule comes from src/lib/pricing.ts.
import type { VendorPage } from "../data/vendor-pages";
import { CLOUD_CAP, CLOUD_FREE_UP_TO, CLOUD_RATE, cloudBill, usd } from "../lib/pricing";
interface Props { calc: NonNullable<VendorPage["calc"]> }
const { calc } = Astro.props;
const start = 100_000;
const vendorBill = (p: (typeof calc.plans)[number], m: number) => (m < p.from ? 0 : m * p.rate) + p.fee;
const first = calc.plans[0];
const data = JSON.stringify({ plans: calc.plans, rd: { from: CLOUD_FREE_UP_TO, rate: CLOUD_RATE, cap: CLOUD_CAP } });
---
<section class="section" id="calculator">
  <div class="wrap">
    <div class="head"><p class="label">Calculator</p><h2 class="h2 sm">{calc.vendor} pricing calculator</h2></div>
    <div class="tool vcalc" data-calc={data}>
      <div class="inputs">
        <label>Monthly tracked revenue (USD)
          <input type="number" class="mtr" min="0" step="500" value={start} inputmode="numeric" />
          <input type="range" class="mtr-range" min="0" max="1000000" step="1000" value={start} aria-label="Monthly tracked revenue" />
          <span class="hint">Gross revenue from all stores, before Apple's and Google's commission.</span>
        </label>
        {calc.plans.length > 1 && (
          <label>{calc.vendor} plan
            <select class="plan">{calc.plans.map((p) => <option value={p.id}>{p.label}</option>)}</select>
          </label>
        )}
        {calc.share && (
          <label>Share of revenue through {calc.vendor} paywalls (%)
            <input type="range" class="share" min="0" max="100" step="5" value="100" aria-label={`Share of revenue through ${calc.vendor} paywalls`} />
            <span class="hint"><span class="share-out">100</span>% of revenue is billed by {calc.vendor}.</span>
          </label>
        )}
      </div>
      <div class="out" aria-live="polite">
        <div class="rows">
          <div class="row"><span class="name">{calc.vendor}</span><span class="bar v-bar" style="width:100%"></span><span class="amt v-amt">{usd(vendorBill(first, start))}</span></div>
          <div class="row us"><span class="name">RevenueDot Pro</span><span class="bar r-bar" style={`width:${(cloudBill(start) / Math.max(vendorBill(first, start), 1)) * 100}%`}></span><span class="amt r-amt">{usd(cloudBill(start))}</span></div>
        </div>
        <p class="small muted diff">A month at {usd(start)} of tracked revenue.</p>
        <div class="go-cta"><a class="btn sm" href="https://app.revenuedot.app/signup">Start for free</a></div>
        <p class="tiny">{calc.note} RevenueDot Pro: $0 until $10,000 a month, then 0.5% of revenue above $10,000, never more than $999. Sources: {calc.sources.map((s, i) => <>{i > 0 && " · "}<a href={s.url} rel={s.url.startsWith("http") ? "noopener" : undefined}>{s.label}</a></>)}.</p>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  document.querySelectorAll(".vcalc").forEach((root) => {
    const d = JSON.parse(root.dataset.calc);
    const q = (s) => root.querySelector(s);
    const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");
    const render = () => {
      const m = Math.max(0, Number(q(".mtr").value) || 0);
      const plan = d.plans.find((p) => p.id === (q(".plan")?.value ?? d.plans[0].id)) ?? d.plans[0];
      const share = q(".share") ? Number(q(".share").value) / 100 : 1;
      if (q(".share-out")) q(".share-out").textContent = String(Math.round(share * 100));
      const billed = m * share;
      const v = (billed < plan.from ? 0 : billed * plan.rate) + plan.fee;
      const r = Math.min(d.rd.cap, Math.max(0, m - d.rd.from) * d.rd.rate);
      const max = Math.max(v, r, 1);
      q(".v-amt").textContent = fmt(v); q(".r-amt").textContent = fmt(r);
      q(".v-bar").style.width = (v / max) * 100 + "%"; q(".r-bar").style.width = (r / max) * 100 + "%";
      q(".diff").textContent = `A month at ${fmt(m)} of tracked revenue: ${fmt(v * 12)} a year on ${plan.label.replace(/ \(.*\)/, "") || "this plan"} against ${fmt(r * 12)} on RevenueDot Pro.`;
    };
    q(".mtr").addEventListener("input", () => { q(".mtr-range").value = q(".mtr").value; render(); });
    q(".mtr-range").addEventListener("input", () => { q(".mtr").value = q(".mtr-range").value; render(); });
    q(".plan")?.addEventListener("change", render);
    q(".share")?.addEventListener("input", render);
    render();
  });
</script>
<style>
  .h2.sm { font-size: clamp(28px, 3.4vw, 40px); }
  .tool { border: 1px solid var(--border); background: var(--panel); display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); }
  .inputs { padding: 28px; border-right: 1px solid var(--border); display: grid; gap: 22px; align-content: start; background: var(--sidebar); }
  .out { padding: 28px; display: grid; gap: 18px; align-content: start; min-width: 0; }
  label { display: grid; gap: 8px; font-size: 13px; font-weight: 600; color: var(--fg-2); }
  input[type=number], select { height: 40px; padding: 0 12px; border: 1px solid var(--border); background: var(--panel); color: var(--fg); font: 500 16px var(--mono); border-radius: 0; width: 100%; }
  select { font: 500 15px var(--font); }
  input[type=range] { width: 100%; accent-color: var(--fg); }
  .hint { font-size: 12px; font-weight: 500; color: var(--fg-3); }
  .go-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .rows { display: grid; gap: 12px; }
  .row { display: grid; grid-template-columns: minmax(0, 150px) minmax(0, 1fr) 96px; gap: 12px; align-items: center; font-size: 14px; }
  .bar { height: 14px; background: var(--fg); min-width: 2px; transition: width var(--base) var(--ease); }
  .row.us .bar { background: var(--accent); }
  .amt { font-family: var(--mono); font-size: 13px; text-align: right; }
  .name { font-weight: 600; }
  .tiny a { color: inherit; }
  @media (max-width: 820px) { .tool { grid-template-columns: minmax(0, 1fr); } .inputs { border-right: 0; border-bottom: 1px solid var(--border); } .row { grid-template-columns: minmax(0, 110px) minmax(0, 1fr) 80px; } }
</style>
