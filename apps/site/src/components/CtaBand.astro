---
import { SITE } from "../site";
interface Props { title?: string; body?: string }
const { title = "Run subscriptions without the revenue share.", body = "Start free on RevenueDot Cloud, free up to $10,000 a month in tracked revenue, or move an existing RevenueCat app with one line of code." } = Astro.props;
---
<section class="dark cta">
  <div class="wrap inner">
    <div class="copy">
      <p class="label">Get started</p>
      <h2 class="h2">{title}</h2>
      <p class="lede">{body}</p>
    </div>
    <div class="btns">
      <a class="btn" href={SITE.signup}>Start free on Cloud</a>
      <a class="btn secondary" href="/migrate-from-revenuecat">Migrate from RevenueCat <span class="arrow">→</span></a>
    </div>
    <p class="small alt">Already have an account? <a href={SITE.login}>Sign in</a> · Prefer your own servers? <a href="/self-host">Self-host free</a></p>
  </div>
</section>
<style>
  .alt { color: var(--fg-2); }
  .alt a { color: inherit; }
  .cta { padding: 96px 0; }
  .inner { display: grid; gap: 32px; }
  .copy { display: grid; gap: 16px; }
  @media (max-width: 720px) { .cta { padding: 64px 0; } }
</style>
