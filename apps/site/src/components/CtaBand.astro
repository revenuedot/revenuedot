---
import { SITE } from "../site";
import { SIGNUP_CTA } from "../lib/pricing";
// The closing call to action. The default speaks to every app developer; switching pages pass `switching` so the
// second button leads to the migration guide instead of the quickstart.
interface Props { title?: string; body?: string; switching?: boolean }
const { switching = false } = Astro.props;
const {
  title = switching ? "Switch from RevenueCat without losing a subscriber." : "Start selling subscriptions in your app today.",
  body = switching
    ? "Start for free on RevenueDot Cloud, import your RevenueCat project with one command, and change one line in your app. Pro costs $0 until your apps make $10,000 a month."
    : "Building and testing are free, and you can test your first purchase before you have a store account. Pro costs $0 until your apps make $10,000 a month.",
} = Astro.props;
const second = switching ? { href: "/migrate-from-revenuecat", label: "Migrate from RevenueCat" } : { href: "/docs/getting-started/quickstart", label: "Read the quickstart" };
---
<section class="dark cta">
  <div class="wrap inner">
    <div class="copy">
      <p class="label">Get started</p>
      <h2 class="h2">{title}</h2>
      <p class="lede">{body}</p>
    </div>
    <div class="btns">
      <a class="btn" href={SITE.signup}>{SIGNUP_CTA}</a>
      <a class="btn secondary" href={second.href}>{second.label} <span class="arrow">→</span></a>
    </div>
    <p class="small alt">Already have an account? <a href={SITE.login}>Sign in</a>{!switching && <> · Switching from RevenueCat? <a href="/migrate-from-revenuecat">Change one line</a></>}</p>
  </div>
</section>
<style>
  .alt { color: var(--fg-2); }
  .alt a { color: inherit; }
  .cta { padding: 96px 0; }
  .inner { display: grid; gap: 32px; }
  .copy { display: grid; gap: 16px; }
  @media (max-width: 720px) { .cta { padding: 64px 0; } }
</style>
