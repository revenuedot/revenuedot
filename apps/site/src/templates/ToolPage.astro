---
// A free calculator page: answer-first head, the tool, how it works, FAQ and related pages.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Faq from "../components/Faq.astro";
import Related from "../components/Related.astro";
import CtaBand from "../components/CtaBand.astro";
import Md from "../components/Md.astro";
import { ogFor } from "../lib/og";
import { webPage } from "../lib/jsonld";
import { plain } from "../lib/md";
import { SITE, type Faq as F } from "../site";
interface Props { path: string; name: string; title: string; metaTitle: string; description: string; answer: string; faq: F[]; related: string[] }
const { path, name, title, metaTitle, description, answer, faq, related } = Astro.props;
const image = ogFor(path);
const app = {
  "@type": "WebApplication",
  name,
  url: new URL(path, SITE.url).href,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web browser",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@id": `${SITE.url}/#organization` },
};
const faqPlain = faq.map((f) => ({ q: f.q, a: plain(f.a) }));
---
<Base title={metaTitle} description={description} path={path} image={image} imageAlt={title}
  crumbs={[{ name: "Free tools", path: "/tools" }, { name, path }]} faq={faqPlain} jsonld={[webPage({ title, description, path, image }), app]}>
  <div class="wrap">
    <PageHead label="Free tool" title={title}><Md class="lede" text={answer} /></PageHead>
  </div>
  <section class="section first tight" aria-label={name}><div class="wrap"><slot /></div></section>
  <slot name="after" />
  <section class="section" id="faq"><div class="wrap"><div class="head"><p class="label">FAQ</p><h2 class="h2 sm">Questions people ask</h2></div><Faq items={faqPlain} open={0} /></div></section>
  <Related items={related} />
  <CtaBand />
</Base>
<style>
  .h2.sm { font-size: clamp(28px, 3.4vw, 40px); }
  :global(.tool) { border: 1px solid var(--border); background: var(--panel); display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); }
  :global(.tool .inputs) { padding: 28px; border-right: 1px solid var(--border); display: grid; gap: 22px; align-content: start; background: var(--sidebar); }
  :global(.tool .out) { padding: 28px; display: grid; gap: 18px; align-content: start; min-width: 0; }
  :global(.tool label) { display: grid; gap: 8px; font-size: 13px; font-weight: 600; color: var(--fg-2); }
  :global(.tool input[type=number]), :global(.tool select) { height: 40px; padding: 0 12px; border: 1px solid var(--border); background: var(--panel); color: var(--fg); font: 500 16px var(--mono); border-radius: 0; width: 100%; }
  :global(.tool select) { font: 500 15px var(--font); text-overflow: ellipsis; }
  :global(.tool .go-cta) { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  :global(.tool input[type=range]) { width: 100%; accent-color: var(--fg); }
  :global(.tool .hint) { font-size: 12px; font-weight: 500; color: var(--fg-3); }
  :global(.tool .big) { font: 600 clamp(30px, 4vw, 44px)/1.1 var(--font); letter-spacing: var(--tracking-title); font-variant-numeric: tabular-nums; }
  :global(.tool .rows) { display: grid; gap: 10px; }
  :global(.tool .row) { display: grid; grid-template-columns: minmax(0, 170px) minmax(0, 1fr) 96px; gap: 12px; align-items: center; font-size: 14px; }
  :global(.tool .row .bar) { height: 14px; background: var(--fg); min-width: 2px; transition: width var(--base) var(--ease); }
  :global(.tool .row.us .bar) { background: var(--accent); }
  :global(.tool .row .amt) { font-family: var(--mono); font-size: 13px; text-align: right; }
  :global(.tool .row .name) { font-weight: 600; }
  :global(.tool .row .name small) { display: block; font-weight: 500; color: var(--fg-3); font-size: 11px; }
  @media (max-width: 820px) { :global(.tool) { grid-template-columns: minmax(0, 1fr); } :global(.tool .inputs) { border-right: 0; border-bottom: 1px solid var(--border); } :global(.tool .row) { grid-template-columns: minmax(0, 120px) minmax(0, 1fr) 80px; } }
</style>
