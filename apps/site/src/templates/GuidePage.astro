---
// Top-level guide pages (Guide in src/data/types.ts, data in src/data/guides.ts). The default slot renders after the
// body blocks and before the FAQ, for page-specific sections such as the AI prompt on /add-in-app-purchases.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Points from "../components/Points.astro";
import Blocks from "../components/Blocks.astro";
import Faq from "../components/Faq.astro";
import Related from "../components/Related.astro";
import CtaBand from "../components/CtaBand.astro";
import Md from "../components/Md.astro";
import type { Guide } from "../data/types";
import { plain } from "../lib/md";
import { ogFor } from "../lib/og";
import { howTo, webPage } from "../lib/jsonld";
import { SITE } from "../site";
interface Props { page: Guide }
const { page } = Astro.props;
const path = page.path;
const image = ogFor(path);
const how = page.howTo ? page.blocks.find((b) => b.h2 === page.howTo && b.steps) : undefined;
const jsonld: object[] = [webPage({ title: page.title, description: page.metaDescription, path, image, about: page.name })];
if (how?.steps) jsonld.push(howTo(how.h2, plain(page.answer), how.steps.map((s) => ({ name: s.name, text: plain(s.text) })), path));
const faq = page.faq.map((f) => ({ q: f.q, a: plain(f.a) }));
const secondary = page.secondary ?? (page.docs[0] ? { href: page.docs[0].href, label: "Read the guide" } : undefined);
---
<Base title={page.metaTitle} description={page.metaDescription} path={path} image={image} imageAlt={page.title}
  crumbs={[...(page.parents ?? []), { name: page.name, path }]} faq={faq} jsonld={jsonld}>
  <div class="wrap">
    <PageHead label={page.label} title={page.title}>
      <Md class="lede answer" text={page.answer} />
      <div class="btns">
        <a class="btn" href={SITE.signup}>Start free on Cloud</a>
        {secondary && <a class="btn secondary" href={secondary.href}>{secondary.label} <span class="arrow">→</span></a>}
      </div>
      <p class="small muted note">{page.note ?? "Free up to $10,000 a month in tracked revenue."} Already have an account? <a href={SITE.login}>Sign in</a></p>
    </PageHead>
  </div>
  {page.points && <div class="pts"><Points points={page.points} /></div>}
  <Blocks blocks={page.blocks} />
  <slot />
  {page.faq.length > 0 && (
    <section class="section" id="faq">
      <div class="wrap">
        <div class="head"><p class="label">FAQ</p><h2 class="h2 sm">Questions people ask</h2></div>
        <Faq items={faq} open={0} />
      </div>
    </section>
  )}
  <Related items={page.related} docs={page.docs} />
  <CtaBand />
</Base>
<style>
  .answer { max-width: 760px; }
  .answer :global(a) { color: var(--fg); }
  .note a { color: var(--fg); }
  .pts { margin-top: 24px; }
  .h2.sm { font-size: clamp(28px, 3.4vw, 40px); }
</style>
