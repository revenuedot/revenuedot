---
// Feature, store, SDK and solution pages (Landing in src/data/types.ts).
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Shot from "../components/Shot.astro";
import Points from "../components/Points.astro";
import Blocks from "../components/Blocks.astro";
import Faq from "../components/Faq.astro";
import Related from "../components/Related.astro";
import CtaBand from "../components/CtaBand.astro";
import Md from "../components/Md.astro";
import Clip from "../components/Clip.astro";
import { CLIPS } from "../lib/clips";
import type { Landing } from "../data/types";
import { SECTIONS, landingPath } from "../data";
import { shot } from "../lib/shots";
import { plain } from "../lib/md";
import { ogFor } from "../lib/og";
import { howTo, webPage } from "../lib/jsonld";
import { SITE } from "../site";
interface Props { page: Landing }
const { page } = Astro.props;
const path = landingPath(page);
const sec = SECTIONS[page.section];
const image = ogFor(path);
const how = page.howTo ? page.blocks.find((b) => b.h2 === page.howTo && b.steps) : undefined;
const jsonld: object[] = [webPage({ title: page.title, description: page.metaDescription, path, image, about: page.name })];
if (how?.steps) jsonld.push(howTo(how.h2, plain(page.answer), how.steps.map((s) => ({ name: s.name, text: plain(s.text) })), path));
const clip = CLIPS[path];
const faq = page.faq.map((f) => ({ q: f.q, a: plain(f.a) }));
---
<Base title={page.metaTitle} description={page.metaDescription} path={path} image={image} imageAlt={page.title}
  crumbs={[{ name: sec.name, path: sec.path }, { name: page.name, path }]} faq={faq} jsonld={jsonld}>
  <div class="wrap">
    <PageHead label={page.label} title={page.title}>
      <Md class="lede answer" text={page.answer} />
      <div class="btns">
        <a class="btn" href={SITE.signup}>Start for free</a>
        {page.docs[0] && <a class="btn secondary" href={page.docs[0].href}>Read the guide <span class="arrow">→</span></a>}
      </div>
      <p class="small muted">Free until your app makes $10,000 a month. Switching from RevenueCat? <a href="/migrate-from-revenuecat">Change one line</a>.</p>
    </PageHead>
    {page.shot && <div class="hero-shot"><Shot light={shot(page.shot.src)} dark={page.shot.dark ? shot(page.shot.dark) : undefined} alt={page.shot.alt} caption={page.shot.caption} eager /></div>}
  </div>
  {clip && (
    <section class="section tight first" aria-label="Product clip">
      <div class="wrap"><Clip name={clip.name} alt={clip.alt} caption={clip.caption} /></div>
    </section>
  )}
  {page.points && <Points points={page.points} />}
  <Blocks blocks={page.blocks} />
  {page.faq.length > 0 && (
    <section class="section" id="faq">
      <div class="wrap">
        <div class="head"><p class="label">FAQ</p><h2 class="h2 sm">{page.name}: questions people ask</h2></div>
        <Faq items={faq} open={0} />
      </div>
    </section>
  )}
  <Related items={page.related} docs={page.docs} />
  <CtaBand />
</Base>
<style>
  .hero-shot { margin: 8px 0 72px; }
  .answer { max-width: 760px; }
  .answer :global(a) { color: var(--fg); }
  .h2.sm { font-size: clamp(28px, 3.4vw, 40px); }
</style>
