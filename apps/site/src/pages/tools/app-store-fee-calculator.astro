---
// App Store and Google Play fee calculator: what a subscription earns after the store's commission and the backend fee.
import ToolPage from "../../templates/ToolPage.astro";
import { STORE_SOURCES } from "../../lib/vendor-pricing";
const faq = [
  { q: "How much does Apple take from in-app subscriptions?", a: "Apple keeps 30% of the subscription price in a subscriber's first year and 15% after one year of paid service. Developers in the App Store Small Business Program, for those who earned under $1 million in the previous calendar year, pay 15% from the first day. See [Apple's subscriptions page](https://developer.apple.com/app-store/subscriptions/) and the [Small Business Program](https://developer.apple.com/app-store/small-business-program/)." },
  { q: "How much does Google Play take from subscriptions?", a: "Google Play's service fee for auto-renewing subscriptions is 15%, regardless of how much the developer earns, in the markets where the updated fee structure has not rolled out yet. Google is rolling out new fee tiers by market, so check [Google's service fee page](https://support.google.com/googleplay/android-developer/answer/112622?hl=en) for your countries." },
  { q: "Does the backend fee apply before or after the store's cut?", a: "RevenueCat, Adapty and Qonversion measure tracked revenue before the store's commission, so their percentage applies to the gross price. That makes RevenueCat's 1% about 1.2% of your proceeds at a 15% commission." },
  { q: "What is the Small Business Program?", a: "Apple's program lowers the commission to 15% for developers who earned up to $1 million in proceeds in the previous calendar year. You must enroll; it is not automatic. If you pass $1 million in a year, the standard rate applies for the rest of that year." },
  { q: "Are taxes included?", a: "No. Apple and Google deduct applicable taxes before paying proceeds in many countries. This calculator shows commission and backend fees only." },
];
---
<ToolPage path="/tools/app-store-fee-calculator" name="App Store fee calculator"
  title="App Store and Google Play fee calculator for subscriptions"
  metaTitle="App Store and Google Play fee calculator"
  description="See what you keep from an iOS or Android subscription after Apple's or Google's commission (15% or 30%) and your subscription backend's fee. Sourced 2026 rules."
  answer="Apple keeps **30%** of a subscription in the subscriber's first year and **15%** after that, or 15% from day one in the Small Business Program. Google Play keeps **15%** of subscriptions in most markets. Enter a price and subscriber count to see what you keep after the store and your backend."
  faq={faq} related={["/tools/revenuecat-fee-calculator", "/tools/subscription-revenue-calculator", "/stores/app-store", "/stores/google-play", "/blog/weekly-vs-annual-subscriptions", "/charts/revenue"]}>
  <div class="tool" id="store-tool">
    <div class="inputs">
      <label>Price per billing period (USD)<input type="number" id="price" min="0" step="0.5" value="9.99" /></label>
      <label>Billing period
        <select id="period"><option value="52">Weekly</option><option value="12" selected>Monthly</option><option value="1">Yearly</option></select>
      </label>
      <label>Paying subscribers<input type="number" id="subs" min="0" step="10" value="1000" /></label>
      <label>Store and program
        <select id="store">
          <option value="apple-y1">App Store, first year of a subscriber (30%)</option>
          <option value="apple-y2">App Store, after one year of paid service (15%)</option>
          <option value="apple-sbp" selected>App Store, Small Business Program (15%)</option>
          <option value="google">Google Play subscriptions (15%)</option>
        </select>
      </label>
      <label>Backend
        <select id="backend">
          <option value="rc">RevenueCat (1% of gross from $2,500 a month)</option>
          <option value="rdcloud" selected>RevenueDot Cloud (free to $10K; planned 0.5% above, max $999)</option>
          <option value="rdself">RevenueDot self-hosted ($0)</option>
        </select>
      </label>
    </div>
    <div class="out" aria-live="polite">
      <div><p class="label">You keep per year</p><p class="big" id="keep">—</p><p class="small muted" id="keep-sub"></p></div>
      <div class="go-cta"><a class="btn sm" href="https://app.revenuedot.app/signup">Start free on Cloud</a><a class="btn secondary sm" href="/tools/revenuecat-fee-calculator">Compare backend fees <span class="arrow">→</span></a></div>
      <div class="rows">
        <div class="row"><span class="name">Customers pay</span><span class="bar" id="b-gross"></span><span class="amt" id="a-gross"></span></div>
        <div class="row"><span class="name">Store commission</span><span class="bar" id="b-store"></span><span class="amt" id="a-store"></span></div>
        <div class="row"><span class="name">Backend fee</span><span class="bar" id="b-backend"></span><span class="amt" id="a-backend"></span></div>
        <div class="row us"><span class="name">You keep</span><span class="bar" id="b-keep"></span><span class="amt" id="a-keep"></span></div>
      </div>
      <p class="tiny">Per year, before taxes. Sources: {STORE_SOURCES.map((s, i) => <>{i > 0 && " · "}<a href={s.url} rel="noopener">{s.label}</a></>)} · <a href="https://www.revenuecat.com/pricing" rel="noopener">RevenueCat pricing</a> · <a href="/pricing">RevenueDot pricing</a>. Google is rolling out new fee tiers by market.</p>
    </div>
  </div>
</ToolPage>
<script is:inline>
  (() => {
    const $ = (id) => document.getElementById(id);
    if (!$("store-tool")) return;
    const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");
    const rate = { "apple-y1": 0.3, "apple-y2": 0.15, "apple-sbp": 0.15, google: 0.15 };
    const backend = (b, monthly) => b === "rc" ? (monthly >= 2500 ? monthly * 0.01 : 0) : b === "rdcloud" ? Math.min(999, Math.max(0, monthly - 10000) * 0.005) : 0;
    const render = () => {
      const price = Math.max(0, Number($("price").value) || 0), per = Number($("period").value), subs = Math.max(0, Number($("subs").value) || 0);
      const gross = price * per * subs, store = gross * rate[$("store").value], fee = backend($("backend").value, gross / 12) * 12, keep = gross - store - fee;
      const set = (k, v) => { $("a-" + k).textContent = fmt(v); $("b-" + k).style.width = (gross ? (v / gross) * 100 : 0) + "%"; };
      set("gross", gross); set("store", store); set("backend", fee); set("keep", keep);
      $("keep").textContent = fmt(keep);
      $("keep-sub").textContent = gross ? `${Math.round((keep / gross) * 1000) / 10}% of what customers pay, ${fmt(keep / 12)} a month.` : "";
    };
    ["price", "period", "subs", "store", "backend"].forEach((id) => $(id).addEventListener("input", render));
    render();
  })();
</script>
