---
import Hub from "../../templates/Hub.astro";
import { TOOLS } from "../../data";
---
<Hub path="/tools" name="Free tools" label="Free tools" cols={3}
  title="Free calculators for subscription apps"
  metaTitle="Free calculators for subscription app developers"
  description="Free calculators for subscription apps: RevenueCat fees next to the alternatives, App Store and Google Play commission, and MRR, ARR and LTV projections. No sign-up."
  answer="Three free calculators, no sign-up: what **RevenueCat** and its alternatives charge at your revenue, what you keep after **Apple's and Google's commission**, and a 12-month **MRR, ARR and LTV** projection from your installs, conversion and churn."
  groups={[{ title: "Calculators", cards: TOOLS.map((t) => ({ href: t.path, title: t.title, text: t.card })) }]} />
