---
import Hub from "../../templates/Hub.astro";
import { TOOLS } from "../../data";
---
<Hub path="/tools" name="Free tools" label="Free tools" cols={3}
  title="Free calculators for subscription apps"
  metaTitle="Free calculators for subscription app developers"
  description="Free calculators for subscription apps: what you keep after App Store and Google Play commission, MRR, ARR and LTV projections, and backend fees. No sign-up."
  answer="Three free calculators, no sign-up: what you keep after **Apple's and Google's commission**, a 12-month **MRR, ARR and LTV** projection from your installs, conversion and churn, and what **RevenueCat**, RevenueDot and other backends charge at your revenue."
  groups={[{ title: "Calculators", cards: TOOLS.map((t) => ({ href: t.path, title: t.title, text: t.card })) }]} />
