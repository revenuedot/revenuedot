---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { CHANGELOG } from "../lib/changelog";
import { SITE } from "../site";
---
<Base
  title="Changelog: what shipped in RevenueDot"
  description="RevenueDot milestones: the RevenueCat-compatible API, App Store and Google Play support, the dashboard, the importer, SDK forks and self-hosting."
  path="/changelog"
  crumbs={[{ name: "Changelog", path: "/changelog" }]}
>
  <div class="wrap">
    <PageHead label="Changelog" title="What shipped" lede="RevenueDot is pre-alpha and built in the open. Every change is in the commit history on GitHub; this page lists the milestones.">
      <div class="btns"><a class="btn secondary" href={`${SITE.github}/commits/main`} rel="noopener">Full history on GitHub <span class="arrow">↗</span></a></div>
    </PageHead>
  </div>
  <section class="section first tight">
    <div class="wrap">
      <ol class="log">
        {CHANGELOG.map((e) => (
          <li class="entry">
            <div class="meta"><time class="num" datetime={e.date}>{e.date}</time><span class="tag muted">{e.tag}</span></div>
            <div class="body">
              <h2 class="h3">{e.title}</h2>
              <ul>{e.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<style>
  .log { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); background: var(--panel); }
  .entry { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 28px; border-bottom: 1px solid var(--border-2); }
  .entry:last-child { border-bottom: 0; }
  .meta { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .body { display: grid; gap: 10px; }
  .body ul { margin: 0; padding-left: 18px; color: var(--fg-2); display: grid; gap: 6px; font-size: 15px; }
  @media (max-width: 720px) { .entry { grid-template-columns: 1fr; gap: 12px; padding: 20px 16px; } .meta { flex-direction: row; align-items: center; } }
</style>
