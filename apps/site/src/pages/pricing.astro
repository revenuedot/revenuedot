---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { PLANS, CLOUD_CAP, CLOUD_FREE_UP_TO, CLOUD_RATE, RC_FREE_UP_TO, RC_RATE, cloudBill, revenueCatBill, usd } from "../lib/pricing";
import { softwareApplication } from "../lib/jsonld";
import { FAQ_COST, FAQ_PRICE_ALT, FAQ_ALTERNATIVE, FAQ_DATA, FAQ_LICENSE } from "../lib/faq";
import Visual from "../components/Visual.astro";
import Clip from "../components/Clip.astro";
import TourPlayer from "../components/TourPlayer.astro";
import Evidence from "../components/Evidence.astro";
import { SITE } from "../site";

const faq = [
  FAQ_COST,
  FAQ_PRICE_ALT,
  { q: "What counts as tracked revenue?", a: "Tracked revenue is the gross value of the App Store, Google Play and other store purchases RevenueDot Cloud processes for your apps in a calendar month, before store fees and taxes. Sandbox and test purchases never count." },
  { q: "Can I export my data?", a: "Yes. You can export everything a project owns at any time, with the same ids, SDK keys and webhook secrets, so you are never locked in. Your apps change only the proxy URL." },
  { q: "Which plan includes single sign-on?", a: "Cloud Standard and Enterprise. Cloud Standard adds single sign-on with SAML 2.0 or OpenID Connect, so your team signs in with Google Workspace, Okta or Microsoft Entra ID, and you can require it for your email domain. It also adds organizations and custom roles. Upgrade any time from Billing in the dashboard; below $10,000 a month of tracked revenue it still costs $0." },
  { q: "What does Enterprise add?", a: "Enterprise has everything in Cloud Standard with no revenue limit. It adds SCIM provisioning, audit logs kept from 30 days to 10 years, signed compliance exports of the audit log and access review, and a commercial license if your company must run its own server. It includes a 99.9% monthly uptime SLA on the purchase path with service credits (10% below 99.9%, 25% below 99.5%, 50% below 99%). Support answers within 1 hour at any hour when purchases fail, within 4 business hours for a broken feature and within 1 business day for questions, in a private Slack channel with a named engineer. We migrate you from RevenueCat with you, sign a DPA and answer security reviews. Pricing is custom, from $50,000 a year." },
  FAQ_ALTERNATIVE,
  FAQ_DATA,
  FAQ_LICENSE,
];
const examples = [5_000, 25_000, 50_000, 100_000, 250_000, 500_000];
const ENT_LICENSE = "With an Enterprise license";
const planCols = ["Cloud Free", "Cloud Standard", "Enterprise", "Own server (advanced)"];
const planRows: [string, string, string, string, string][] = [
  ["Price", "$0", `0.5% of tracked revenue above ${usd(CLOUD_FREE_UP_TO)} a month, never more than ${usd(CLOUD_CAP)} a month`, "Custom, from $50,000 a year", "Free"],
  ["Tracked revenue", "Up to $10,000 a month", "Up to $1M a month", "No limit", "No limit"],
  ["Open-source core features", "Yes", "Yes", "Yes", "Yes"],
  ["Apps, projects and teammates", "Unlimited, with Admin, Developer and Viewer roles", "Unlimited, with Admin, Developer and Viewer roles", "Unlimited, with Admin, Developer and Viewer roles", "Unlimited, with Admin, Developer and Viewer roles"],
  ["Audit log", "Kept 90 days", "Kept 90 days", "Kept 30 days to 10 years, your choice", "Kept in your own database"],
  ["Organizations and custom roles", "No", "Yes", "Yes", ENT_LICENSE],
  ["Single sign-on (SAML, OpenID Connect)", "No", "Yes, and you can require it for your email domain", "Yes, and you can require it for your email domain", ENT_LICENSE],
  ["SCIM provisioning", "No", "No", "Yes", ENT_LICENSE],
  ["Compliance exports", "No", "No", "Signed exports of the audit log and access review", ENT_LICENSE],
  ["Where your data lives", "US", "US", "US, or your own cloud with the commercial license", "Your own servers"],
  ["License", "Not needed: we run it", "Not needed: we run it", "Commercial license to self-host without AGPL duties, with every enterprise feature", "AGPL-3.0"],
  ["Uptime SLA", "No", "No", "99.9% a month on the purchase path, with service credits", "No"],
  ["Support", "Community and email", "Email, first reply within 2 business days", "1 hour when purchases fail, at any hour; private Slack channel and a named engineer", "GitHub community"],
];
const cellClass = (c: string) => (c === "Yes" ? "yes" : c === "No" ? "no" : undefined);
---
<Base
  title="Pricing"
  fullTitle="Pricing: RevenueDot Cloud free up to $10K a month"
  description="RevenueDot Cloud is free up to $10,000 a month in tracked revenue, then 0.5%, and never more than $999 a month. Start free and run nothing yourself."
  path="/pricing"
  crumbs={[{ name: "Pricing", path: "/pricing" }]}
  faq={faq}
  jsonld={[softwareApplication()]}
>
  <div class="wrap">
    <PageHead label="Pricing" title="Free on Cloud up to $10K a month." lede={`RevenueDot Cloud is free while your app tracks up to ${usd(CLOUD_FREE_UP_TO)} a month, and paid plans are capped at ${usd(CLOUD_CAP)} a month.`}>
      <div class="btns"><a class="btn" href={SITE.signup}>Start free on Cloud</a></div>
    </PageHead>
  </div>

  <section class="section first plans-section" aria-label="Plans" data-fast-scroll="viewed_pricing_plans">
    <div class="wrap">
      <div class="grid"><div class="gi cols-3 plans">
        {PLANS.map((p) => (
          <div class="cell plan">
            <div class="plan-top">
              <h2 class="h3">{p.name}</h2>
              {p.available ? <span class="tag">Available</span> : <span class="tag gold">Coming</span>}
            </div>
            <p class="price">{p.price}</p>
            <p class="tiny">{p.priceNote}</p>
            <p class="summary">{p.summary}</p>
            <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
            <a class={`btn ${p.id === "cloud-free" ? "" : "secondary"}`} href={p.cta.href} rel={p.cta.href.startsWith("http") ? "noopener" : undefined}>{p.cta.label}</a>
          </div>
        ))}
      </div></div>
      <p class="tiny note">Outcome add-ons (failed-payment recovery, win-backs, refund defense) will be priced as a share of the money they recover.</p>
      <div class="billing-shot">
        <p class="label">What the Billing page shows</p>
        <p class="small muted">Tracked revenue by project, the bill so far and the cap, on the real Billing page of a Cloud Standard account.</p>
        <Visual name="cloud-billing" />
      </div>
    </div>
  </section>

  <section class="section" id="film">
    <div class="wrap">
      <div class="head">
        <p class="label">The price in 43 seconds</p>
        <h2 class="h2">Your bill stops at {usd(CLOUD_CAP)} a month</h2>
        <p class="lede">Watch an app switch from RevenueCat in one line, see the dashboard it runs from, and read the price curve from free to {usd(CLOUD_CAP)} a month.</p>
      </div>
      <div class="film"><TourPlayer name="revenuedot-platform-teaser" seconds={43} label="Watch the teaser" location="pricing" /></div>
    </div>
  </section>

  <section class="section" id="compare-plans" data-fast-scroll="viewed_pricing_compare">
    <div class="wrap">
      <div class="head">
        <p class="label">Compare plans</p>
        <h2 class="h2">Single sign-on comes with Cloud Standard</h2>
        <p class="lede">Every plan runs the same open-source core, and the plans differ in revenue covered, team sign-in, compliance and support.</p>
      </div>
      <div class="table-wrap plan-table">
        <table>
          <caption class="sr-only">What each RevenueDot plan includes</caption>
          <thead><tr><th scope="col">Feature</th>{planCols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {planRows.map(([topic, ...cells]) => (
              <tr>
                <th scope="row">{topic}</th>
                {cells.map((c) => <td class={cellClass(c)}>{c}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="team-controls">
    <div class="wrap">
      <div class="head">
        <p class="label">Team controls</p>
        <h2 class="h2">Roles, single sign-on and audit logs on screen</h2>
        <p class="lede">These are the team controls from the plan table, recorded in the dashboard with example data. The plan table says which plan includes each one.</p>
      </div>
      <div class="controls">
        <Clip name="revenuedot-loop-roles-v1" sizes="(max-width: 900px) 100vw, 380px" alt="The organization's Roles page: opening New custom role, typing a name and ticking the scopes it allows" caption="Custom roles: pick exactly which scopes a role has." />
        <Clip name="revenuedot-loop-sso-v1" sizes="(max-width: 900px) 100vw, 380px" alt="Organization settings, Single sign-on: an OpenID Connect connection and its verified domain, then turning on Require single sign-on and confirming it" caption="Single sign-on: connect your identity provider and require it for your domain." />
        <Clip name="revenuedot-loop-audit-v1" sizes="(max-width: 900px) 100vw, 380px" alt="The Audit log listing who changed what and when, then the Compliance exports page with a signed audit log export" caption="The audit log, and signed compliance exports for Enterprise." />
      </div>
    </div>
  </section>

  <section class="section" id="calculator" data-fast-scroll="viewed_pricing_calculator">
    <div class="wrap">
      <div class="head">
        <p class="label">Compare your bill</p>
        <h2 class="h2">What you would pay each month</h2>
        <p class="lede">Once tracked revenue reaches {usd(RC_FREE_UP_TO)} a month, RevenueCat charges {Math.round(RC_RATE * 100)}% of all of it. RevenueDot Cloud Standard charges {CLOUD_RATE * 100}% above {usd(CLOUD_FREE_UP_TO)}, capped at {usd(CLOUD_CAP)}.</p>
      </div>
      <div class="grid calc"><div class="gi cols-3">
        <div class="cell span">
          <label for="mtr" class="label">Monthly tracked revenue</label>
          <output id="mtr-out" for="mtr" class="stat">$50,000</output>
          <input id="mtr" type="range" min="0" max="1000000" step="5000" value="50000" aria-describedby="mtr-help" />
          <p id="mtr-help" class="tiny">Drag to set your app's monthly revenue from the stores, before fees.</p>
        </div>
        <div class="cell"><p class="label">RevenueCat</p><p class="stat" id="rc">{usd(revenueCatBill(50_000))}</p><p>a month, from its public pricing</p></div>
        <div class="cell"><p class="label">RevenueDot Cloud</p><p class="stat" id="cloud">{usd(cloudBill(50_000))}</p><p>a month (Cloud Standard)</p></div>
      </div></div>
      <div class="table-wrap examples">
        <table>
          <caption class="sr-only">Monthly price at common revenue levels</caption>
          <thead><tr><th scope="col">Monthly tracked revenue</th><th scope="col">RevenueCat</th><th scope="col">RevenueDot Cloud</th><th scope="col">You keep with Cloud</th></tr></thead>
          <tbody>
            {examples.map((m) => (
              <tr>
                <th scope="row" class="num-cell">{usd(m)}</th>
                <td class="num-cell">{usd(revenueCatBill(m))}</td>
                <td class="num-cell">{usd(cloudBill(m))}</td>
                <td class="num-cell">{usd(revenueCatBill(m) - cloudBill(m))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tiny caption">RevenueCat price from <a href="https://www.revenuecat.com/pricing" rel="noopener">revenuecat.com/pricing</a>, checked {SITE.pricesChecked}; RevenueCat's paywall and funnel tools are priced separately. Adapty, Qonversion, Superwall and Apphud at the same levels: <a href="/cheaper-revenuecat-alternatives">cheaper RevenueCat alternatives</a>.</p>
      <div class="rc-ev">
        <p class="label">RevenueCat's pricing page, as captured</p>
        <Evidence keys={["RevenueCat/pricing/free-to-2500-then-1-percent", "RevenueCat/community-pro-plan-payments/staff-reply-1-percent-of-whole-mtr", "RevenueDot/pricing/plans"]} layout="grid" width={340} />
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="head"><p class="label">FAQ</p><h2 class="h2">Pricing questions</h2></div>
      <Faq items={faq} open={0} />
    </div>
  </section>

  <CtaBand />
</Base>

<script is:inline define:vars={{ RC_FREE_UP_TO, RC_RATE, CLOUD_FREE_UP_TO, CLOUD_RATE, CLOUD_CAP }}>
  const f = (n) => "$" + Math.round(n).toLocaleString("en-US");
  const input = document.getElementById("mtr");
  const update = () => {
    const m = Number(input.value);
    document.getElementById("mtr-out").textContent = f(m);
    document.getElementById("rc").textContent = f(m >= RC_FREE_UP_TO ? m * RC_RATE : 0);
    document.getElementById("cloud").textContent = f(Math.min(CLOUD_CAP, Math.max(0, m - CLOUD_FREE_UP_TO) * CLOUD_RATE));
  };
  input.addEventListener("input", update);
</script>

<style>
  .plans-section { padding-top: 0; }
  .plan { display: flex; flex-direction: column; gap: 12px; }
  .plan-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .plan .price { color: var(--fg); font: 600 44px/1 var(--font); letter-spacing: var(--tracking-title); font-variant-numeric: tabular-nums; margin-top: 8px; }
  .summary { min-height: 96px; }
  .plan ul { list-style: none; margin: 4px 0 12px; padding: 0; display: grid; gap: 8px; font-size: 14px; color: var(--fg-2); }
  .plan li { padding-left: 16px; position: relative; }
  .plan li::before { content: ""; position: absolute; left: 0; top: .65em; width: 6px; height: 6px; background: var(--fg); }
  .plan .btn { justify-content: center; margin-top: auto; }
  .note { margin-top: 20px; max-width: 820px; }
  .film { max-width: 1040px; }
  .controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 900px) { .controls { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
  .billing-shot { margin-top: 48px; display: grid; gap: 8px; }
  .billing-shot .small { margin-bottom: 8px; }
  .rc-ev { margin-top: 32px; display: grid; gap: 16px; }
  .calc .span { grid-column: 1 / -1; }
  .calc input[type="range"] { width: 100%; accent-color: var(--fg); height: 32px; margin: 4px 0; }
  .examples { margin-top: 32px; }
  .plan-table table { min-width: 860px; }
  .plan-table td { color: var(--fg-2); min-width: 150px; }
  .plan-table td.yes { color: var(--up); }
  .plan-table td.no { color: var(--fg-3); }
  .plan-table tbody th { min-width: 160px; position: sticky; left: 0; background: var(--panel); z-index: 1; box-shadow: inset -1px 0 0 var(--border-2); }
  .plan-table thead th:first-child { position: sticky; left: 0; z-index: 2; box-shadow: inset -1px 0 0 var(--border); }
  @media (max-width: 640px) { .plan-table table { min-width: 720px; } .plan-table td { min-width: 130px; } .plan-table tbody th { min-width: 120px; } }
  @media (max-width: 1100px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } .summary { min-height: 0; } }
  @media (max-width: 640px) { .plans { grid-template-columns: 1fr; } }
</style>
