---
import Hub from "../../templates/Hub.astro";
import { LANDINGS, landingPath } from "../../data";
import { platformLogo } from "../../lib/platform-logos";
const cards = LANDINGS.filter((l) => l.section === "solutions").map((l) => ({ href: landingPath(l), title: l.name, text: l.card, logo: platformLogo(l.slug) }));
---
<Hub path="/solutions" name="Solutions" label="Solutions" title={"Solutions for subscription app teams"} metaTitle={"Solutions: indie apps, studios, self-hosting, web-to-app"}
  description={"How indie developers, app studios and teams with data rules use RevenueDot: start free, run many apps, sell on the web, self-host and keep data in their region."}
  answer={"RevenueDot fits any app that sells subscriptions or in-app purchases: indie developers who want a free backend until $10,000 a month, apps that already sell with their own store code, studios running many apps, teams that must keep data in their own region, and apps selling on the web. Apps on RevenueCat can switch by changing one line."}
  groups={[{ title: "All solutions", cards }]} />
