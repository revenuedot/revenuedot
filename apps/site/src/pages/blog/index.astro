---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { SITE } from "../site";
import { readdirSync, readFileSync, existsSync } from "node:fs";
import path from "node:path";

// Posts are Markdown in the revenuedot/docs repo (blog/). When that repo sits next to this one (the workspace layout
// in ../AGENTS.md), the index is built from its front matter; otherwise it shows the link to the folder.
type Post = { title: string; description: string; date: string; slug: string };
const dir = path.resolve(process.cwd(), "../../../docs/blog");
const posts: Post[] = [];
if (existsSync(dir)) {
  for (const f of readdirSync(dir).filter((f) => f.endsWith(".md") || f.endsWith(".mdx"))) {
    if (/^readme/i.test(f)) continue;
    const src = readFileSync(path.join(dir, f), "utf8");
    const fm = src.match(/^---\n([\s\S]*?)\n---/)?.[1] ?? "";
    const get = (k: string) => fm.match(new RegExp(`^${k}:\\s*["']?(.*?)["']?\\s*$`, "m"))?.[1] ?? "";
    const title = get("title") || src.match(/^#\s+(.+)$/m)?.[1] || f.replace(/\.mdx?$/, "");
    if (get("draft") === "true") continue;
    posts.push({ title, description: get("description"), date: get("date"), slug: f });
  }
}
posts.sort((a, b) => b.date.localeCompare(a.date));
---
<Base
  title="Blog: in-app purchases, subscriptions and RevenueCat"
  description="The RevenueDot blog: guides on in-app purchase backends, subscription infrastructure, self-hosting and migrating from RevenueCat. Written in the open on GitHub."
  path="/blog"
  crumbs={[{ name: "Blog", path: "/blog" }]}
>
  <div class="wrap">
    <PageHead label="Blog" title="Notes on subscription infrastructure, written in the open" lede="Posts are Markdown in the revenuedot/docs repository on GitHub, next to the documentation they link to.">
      <div class="btns"><a class="btn secondary" href={SITE.docsBlog} rel="noopener">All posts on GitHub <span class="arrow">↗</span></a></div>
    </PageHead>
  </div>
  <section class="section first tight">
    <div class="wrap">
      {posts.length ? (
        <div class="list">
          {posts.map((p) => (
            <a class="post" href={`${SITE.docs}/blob/main/blog/${p.slug}`} rel="noopener">
              <span class="num">{p.date}</span>
              <span class="post-body"><span class="h3">{p.title}</span>{p.description && <span class="muted small">{p.description}</span>}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty">
          <p class="label">No posts yet</p>
          <p class="muted">The first posts are being written. Follow along in the <a href={SITE.docsBlog} rel="noopener">blog folder on GitHub</a>, or read the <a href="/changelog">changelog</a> for what shipped.</p>
        </div>
      )}
    </div>
  </section>
</Base>
<style>
  .list { border: 1px solid var(--border); background: var(--panel); }
  .post { display: grid; grid-template-columns: 120px 1fr; gap: 24px; padding: 24px; border-bottom: 1px solid var(--border-2); text-decoration: none; }
  .post:last-child { border-bottom: 0; }
  .post:hover { background: var(--hover); }
  .post-body { display: grid; gap: 6px; }
  .empty { border: 1px solid var(--border); background: var(--panel); padding: 40px 28px; display: grid; gap: 12px; }
  @media (max-width: 640px) { .post { grid-template-columns: 1fr; gap: 8px; padding: 20px 16px; } }
</style>
