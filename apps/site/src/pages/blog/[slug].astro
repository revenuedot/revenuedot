---
// Every post in revenuedot/docs blog/ at /blog/<slug>.
import { render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { blogPosts, lastModified, type BlogPost } from "../../lib/docs";
import { blogPosting, faqPage } from "../../lib/jsonld";
import { DOCS_REPO } from "../../lib/docs-source.mjs";
import { ogFor } from "../../lib/og";

export async function getStaticPaths() {
  const posts = await blogPosts();
  return posts.map((post, i) => ({ params: { slug: post.slug }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}

const { post, newer, older } = Astro.props as { post: BlogPost; newer?: BlogPost; older?: BlogPost };
const { Content, headings } = await render(post.entry);
const { title, description, href: path, date, author } = post;
const image = ogFor(path);
// The post's "## FAQ" section (### question, then answer paragraphs) becomes FAQPage markup, so answer engines can quote it.
const plainMd = (t: string) => t.replace(/!\[[^\]]*\]\([^)]*\)/g, "").replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").replace(/[*`]/g, "").replace(/\s+/g, " ").trim();
const faqBlock = (post.entry.body ?? "").split(/^## FAQ.*$/m)[1]?.split(/^## /m)[0] ?? "";
const faq = faqBlock.split(/^### /m).slice(1).map((chunk) => {
  const [q, ...rest] = chunk.split("\n");
  return { q: plainMd(q), a: plainMd(rest.join(" ")) };
}).filter((f) => f.q && f.a);
const modified = lastModified(`${post.entry.id}.md`);
const fullTitle = [" | RevenueDot Blog", " | RevenueDot"].map((s) => title + s).find((t) => t.length <= 70) ?? title;
const item = (p?: BlogPost) => p && { id: p.entry.id, href: p.href, label: p.title, title: p.title, description: p.description };
---
<Docs
  title={title}
  fullTitle={fullTitle}
  description={description}
  path={path}
  crumbs={[{ name: "Blog", path: "/blog" }, { name: title, path }]}
  headings={headings}
  prev={item(newer)}
  next={item(older)}
  prevLabel="Newer post"
  nextLabel="Older post"
  editUrl={`${DOCS_REPO}/edit/main/${post.entry.id}.md`}
  editLabel="Edit this post on GitHub"
  mdUrl={`${path}.md`}
  published={date || undefined}
  section="Blog"
  image={image}
  jsonld={[blogPosting({ title, description, path, published: date || undefined, modified, author, image }), ...(faq.length ? [faqPage(faq)] : [])]}
>
  <Content />
</Docs>
