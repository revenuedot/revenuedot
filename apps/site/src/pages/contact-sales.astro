---
import Base from "../layouts/Base.astro";
import { getCountries, getCountryCallingCode } from "libphonenumber-js/max";
import { CURRENT, NEEDS, PLATFORMS, REVENUE, ROLES, TIMELINE } from "../../worker/lead";
import { SITE } from "../site";

// One question per step (the script below turns the steps on). Without JavaScript every step shows and the form posts as
// one page. Country list: "🇺🇸 +1 United States", sorted by name; /api/geo picks the visitor's country on load.
const names = new Intl.DisplayNames(["en"], { type: "region" });
const flag = (cc: string) => String.fromCodePoint(...[...cc].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65));
const countries = getCountries()
  .map((cc) => ({ cc, name: names.of(cc) ?? cc, code: getCountryCallingCode(cc) }))
  .sort((a, b) => a.name.localeCompare(b.name));
const KEYS = "ABCDEFGHIJ";
---
<Base
  title="Contact sales"
  description="Talk to RevenueDot sales about Enterprise: custom pricing from $50,000 a year, self-hosting with a commercial licence, an uptime SLA and migration help."
  path="/contact-sales"
  crumbs={[{ name: "Pricing", path: "/pricing" }, { name: "Contact sales", path: "/contact-sales" }]}
>
  <section class="cs" aria-labelledby="cs-title">
    <div class="wrap cs-grid">
      <div class="cs-main">
        <p class="label cs-eyebrow"><span class="dot"></span> Enterprise · custom pricing from $50K a year</p>
        <h1 id="cs-title" class="cs-h1">Talk to sales</h1>

        <div class="cs-card">
          <div class="cs-progress" aria-hidden="true"><span id="cs-bar"></span></div>
          <form id="cs-form" class="cs-form" method="post" action="/api/contact-sales" novalidate>
            <p class="cs-count" id="cs-count" aria-live="polite"></p>

            <section class="step" data-step="1" data-fields="email">
              <label class="q" for="email">What is your work email?</label>
              <p class="qh">We will send your quote here.</p>
              <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" placeholder="you@company.com" aria-describedby="err-email" />
              <p class="err" id="err-email" hidden></p>
            </section>

            <fieldset class="step" data-step="2" data-fields="revenue" data-auto>
              <legend class="q">How much do your apps make in the stores each month?</legend>
              <p class="qh">Across all your apps, before Apple and Google take their fees. Our pricing is based on it.</p>
              <div class="opts">
                {REVENUE.map(([v, l], i) => <label class="opt"><input type="radio" name="revenue" value={v} required /><span><kbd>{KEYS[i]}</kbd>{l}</span></label>)}
              </div>
              <p class="err" id="err-revenue" hidden></p>
            </fieldset>

            <fieldset class="step" data-step="3" data-fields="current currentOther" data-auto>
              <legend class="q">What do you use for in-app purchases today?</legend>
              <div class="opts">
                {CURRENT.map(([v, l], i) => <label class="opt"><input type="radio" name="current" value={v} required /><span><kbd>{KEYS[i]}</kbd>{l}</span></label>)}
              </div>
              <p class="err" id="err-current" hidden></p>
              <div class="fld" id="other-wrap">
                <label for="currentOther">If Other, which one?</label>
                <input id="currentOther" name="currentOther" type="text" maxlength="80" placeholder="e.g. Glassfy, Purchasely, Stripe" aria-describedby="err-currentOther" />
                <p class="err" id="err-currentOther" hidden></p>
              </div>
            </fieldset>


            <fieldset class="step" data-step="4" data-fields="timeline" data-auto>
              <legend class="q">When do you want to start?</legend>
              <div class="opts">
                {TIMELINE.map(([v, l], i) => <label class="opt"><input type="radio" name="timeline" value={v} required /><span><kbd>{KEYS[i]}</kbd>{l}</span></label>)}
              </div>
              <p class="err" id="err-timeline" hidden></p>
            </fieldset>

            <fieldset class="step" data-step="5" data-fields="name company phone">
              <legend class="q">How do we reach you?</legend>
              <p class="qh">We call to set up a 30-minute call about your quote.</p>
              <div class="pair">
                <div class="fld">
                  <label for="name">Full name</label>
                  <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="err-name" />
                  <p class="err" id="err-name" hidden></p>
                </div>
                <div class="fld">
                  <label for="company">Company</label>
                  <input id="company" name="company" type="text" autocomplete="organization" required maxlength="160" aria-describedby="err-company" />
                  <p class="err" id="err-company" hidden></p>
                </div>
              </div>
              <div class="fld">
                <label for="phone">Phone number</label>
                <div class="phone">
                  <select id="phoneCountry" name="phoneCountry" autocomplete="tel-country-code" aria-label="Country calling code">
                    {countries.map((c) => <option value={c.cc} selected={c.cc === "US"}>{`${flag(c.cc)} +${c.code} ${c.name}`}</option>)}
                  </select>
                  <input id="phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" required maxlength="40" placeholder="201 555 0123" aria-describedby="err-phone" />
                </div>
                <p class="err" id="err-phone" hidden></p>
              </div>
            </fieldset>


            <div class="hp" aria-hidden="true"><label for="fax">Fax</label><input id="fax" name="fax" type="text" tabindex="-1" autocomplete="off" /></div>
            <input type="hidden" name="started" id="started" value="" />
            <input type="hidden" name="draftId" id="draftId" value="" />

            <div class="nav">
              <button type="button" class="btn secondary" id="cs-back" hidden>Back</button>
              <button type="submit" class="btn" id="cs-next">Contact sales</button>
              <span class="tiny enter" id="cs-enter" hidden>or press <kbd>Enter ↵</kbd></span>
            </div>
            <p class="cs-status" id="cs-status" role="alert" hidden></p>
          </form>

          <div class="cs-done" id="cs-done" tabindex="-1" hidden>
            <p class="label"><span class="dot"></span> Request sent</p>
            <h2 class="h3" id="cs-done-title">Thanks. We will reply within one business day.</h2>
            <p class="muted" id="cs-done-body"></p>
            <div class="btns" id="cs-done-cloud" hidden>
              <a class="btn" href={SITE.signup}>Start free on Cloud</a>
              <a class="btn secondary" href="/pricing">See pricing</a>
            </div>
          </div>
        </div>
        <p class="tiny cs-privacy">We use your answers only to reply to you. See our <a href="/legal/privacy">privacy policy</a>.</p>
      </div>

      <aside class="cs-aside">
        <div class="cs-price">
          <p class="label">Enterprise pricing</p>
          <p class="cs-big">From $50K</p>
          <p class="small muted">a year, with custom pricing for your scale and deployment.</p>
        </div>
        <div>
          <p class="label">Included today</p>
          <ul class="cs-list">
            <li>A commercial licence to self-host RevenueDot in your own cloud</li>
            <li>An uptime SLA on the purchase path, with service credits</li>
            <li>A 1-hour response, any time, when purchases are failing</li>
            <li>Your migration from RevenueCat, done with you</li>
            <li>A data processing agreement and security reviews</li>
          </ul>
        </div>
        <div>
          <p class="label">Rolling out to Enterprise first</p>
          <ul class="cs-list"><li>Single sign-on (SAML) and SCIM</li><li>EU and US data regions</li></ul>
        </div>
        <p class="tiny">Prefer email? Write to <a href={`mailto:${SITE.email.sales}`}>{SITE.email.sales}</a>.</p>
        <p class="tiny">Smaller app? <a href={SITE.signup}>RevenueDot Cloud</a> is free up to $10,000 a month, with no call needed.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Component rules set display, which would otherwise override the hidden attribute. */
  .cs [hidden] { display: none !important; }
  .cs { padding: 40px 0 96px; }
  .cs-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 320px); gap: 56px; align-items: start; }
  .cs-eyebrow { display: flex; align-items: center; gap: 10px; }
  .cs-h1 { font-size: clamp(32px, 4vw, 48px); line-height: 1.05; letter-spacing: var(--tracking-title); margin: 12px 0 24px; }
  .cs-card { border: 1px solid var(--border); background: var(--panel); position: relative; min-width: 0; }
  .cs-progress { height: 3px; background: var(--border-2); }
  .cs-progress span { display: block; height: 100%; width: 0; background: var(--fg); transition: width var(--base) var(--ease); }
  .cs-form { padding: 32px 40px 36px; display: grid; gap: 28px; }
  .cs-count { margin: 0; font: 500 12px var(--mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-3); }
  .step { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 20px; }
  /* A floated legend becomes an ordinary grid item, so the step's gap spaces it like the other questions. */
  .q { display: block; float: left; width: 100%; margin: 0; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.25; font-weight: 700; letter-spacing: -0.025em; padding: 0; text-wrap: balance; }
  label.q { float: none; }
  .qh { margin: -10px 0 0; font-size: 14.5px; line-height: 1.5; color: var(--fg-3); max-width: 60ch; }
  .sub, .fld > label { font-size: 13px; font-weight: 600; color: var(--fg-2); }
  .fld { display: grid; gap: 8px; min-width: 0; }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  input[type=text], input[type=email], input[type=tel], select, textarea {
    width: 100%; min-width: 0; height: 48px; padding: 0 14px; border: 1px solid var(--border); background: var(--panel); color: var(--fg);
    font: 500 17px var(--font); border-radius: 0; -webkit-appearance: none; appearance: none; transition: border-color var(--fast) var(--ease);
  }
  #email { height: 56px; font-size: 20px; }
  select { padding-right: 34px; text-overflow: ellipsis; background-image: linear-gradient(45deg, transparent 50%, var(--fg-3) 50%), linear-gradient(135deg, var(--fg-3) 50%, transparent 50%); background-position: right 16px top 21px, right 11px top 21px; background-size: 5px 5px; background-repeat: no-repeat; }
  textarea { height: auto; padding: 12px 14px; line-height: 1.5; resize: vertical; font-size: 16px; }
  input:hover, select:hover, textarea:hover { border-color: var(--fg-3); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: -1px; border-color: var(--fg); }
  [aria-invalid="true"] { border-color: var(--down) !important; }
  .phone { display: grid; grid-template-columns: minmax(0, 170px) minmax(0, 1fr); }
  .phone select { border-right: 0; }
  .opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .opts.compact { display: flex; flex-wrap: wrap; }
  .opt { position: relative; display: flex; cursor: pointer; min-width: 0; }
  .opt input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .opt span { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 48px; padding: 10px 14px; border: 1px solid var(--border); background: var(--panel); font-size: 15px; font-weight: 500; line-height: 1.3; color: var(--fg); transition: border-color var(--fast) var(--ease); }
  .opts.compact .opt span { min-height: 40px; width: auto; font-size: 14px; color: var(--fg-2); }
  .opt:hover span { border-color: var(--fg-3); }
  .opt input:checked + span { border-color: var(--fg); background: var(--fg); color: var(--bg); }
  .opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 1px; }
  kbd { display: inline-grid; place-items: center; min-width: 22px; height: 22px; padding: 0 5px; border: 1px solid var(--border); font: 500 11px var(--mono); color: var(--fg-3); background: var(--sidebar); flex: none; }
  .opt input:checked + span kbd { border-color: var(--bg); color: var(--bg); background: transparent; }
  .step[data-invalid] .opt span { border-color: var(--down); }
  .err { margin: 0; font-size: 13px; font-weight: 600; color: var(--down); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .nav { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding-top: 4px; }
  .nav .btn { cursor: pointer; }
  .nav .btn[disabled] { opacity: .6; cursor: progress; }
  .enter kbd { margin-left: 4px; }
  .cs-status { margin: 0; padding: 12px 14px; border: 1px solid var(--down); color: var(--down); font-size: 14px; font-weight: 600; }
  .cs-done { padding: 48px 40px; display: grid; gap: 14px; }
  .cs-done:focus { outline: none; }
  .cs-privacy { margin-top: 14px; }
  .cs-aside { display: grid; gap: 28px; padding-top: 70px; }
  .cs-price { border: 1px solid var(--border); padding: 20px; background: var(--sidebar); display: grid; gap: 6px; }
  .cs-big { font: 700 clamp(30px, 3.4vw, 40px)/1.05 var(--font); letter-spacing: var(--tracking-title); }
  .cs-list { margin: 10px 0 0; padding-left: 18px; display: grid; gap: 8px; font-size: 14px; line-height: 1.5; color: var(--fg-2); }
  /* Step mode (JavaScript on): one step at a time. */
  .js-steps .step { display: none; }
  .js-steps .step.on { display: grid; animation: in var(--base) var(--ease); }
  @keyframes in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .js-steps .step.on { animation: none; } .cs-progress span { transition: none; } }
  .cs-count:empty { display: none; }
  @media (max-width: 960px) {
    .cs-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .cs-aside { padding-top: 0; }
  }
  @media (max-width: 560px) {
    .cs { padding: 24px 0 64px; }
    .cs-form { padding: 24px 16px 24px; gap: 22px; }
    .step { gap: 16px; }
    .q { font-size: 21px; }
    .qh { margin-top: -8px; font-size: 14px; }
    .cs-done { padding: 32px 16px; }
    .opts, .pair { grid-template-columns: minmax(0, 1fr); }
    .phone { grid-template-columns: minmax(0, 120px) minmax(0, 1fr); }
    .nav { display: grid; grid-template-columns: auto 1fr; }
    .nav .btn { justify-content: center; }
    .nav #cs-next:only-of-type, .nav #cs-back[hidden] + #cs-next { grid-column: 1 / -1; }
    .enter { display: none; }
  }
</style>

<script>
  import { AsYouType, getExampleNumber, parsePhoneNumberFromString, type CountryCode } from "libphonenumber-js/max";
  import examples from "libphonenumber-js/mobile/examples";
  import { isEmail, parsePhone, validate } from "../../worker/lead";

  const form = document.getElementById("cs-form") as HTMLFormElement;
  const steps = [...form.querySelectorAll<HTMLElement>(".step")];
  const next = document.getElementById("cs-next") as HTMLButtonElement;
  const back = document.getElementById("cs-back") as HTMLButtonElement;
  const bar = document.getElementById("cs-bar") as HTMLSpanElement;
  const count = document.getElementById("cs-count") as HTMLParagraphElement;
  const enter = document.getElementById("cs-enter") as HTMLSpanElement;
  const status = document.getElementById("cs-status") as HTMLParagraphElement;
  const country = document.getElementById("phoneCountry") as HTMLSelectElement;
  const phone = document.getElementById("phone") as HTMLInputElement;
  const draftId = document.getElementById("draftId") as HTMLInputElement;
  (document.getElementById("started") as HTMLInputElement).value = String(Date.now());
  draftId.value = crypto.randomUUID();
  form.classList.add("js-steps");
  let at = 0;

  // Phone: the example number for the chosen country as the placeholder; a number typed with + picks its country.
  const setPlaceholder = () => { const ex = getExampleNumber(country.value as CountryCode, examples); phone.placeholder = ex ? ex.formatNational() : ""; };
  let countryTouched = false;
  country.addEventListener("change", () => { countryTouched = true; setPlaceholder(); });
  setPlaceholder();
  fetch("/api/geo").then((r) => (r.ok ? r.json() : null)).then((g) => {
    if (!countryTouched && g?.country && [...country.options].some((o) => o.value === g.country)) { country.value = g.country; setPlaceholder(); }
  }).catch(() => {});
  phone.addEventListener("input", () => {
    if (!phone.value.trim().startsWith("+")) return;
    const t = new AsYouType(); t.input(phone.value);
    const cc = t.getCountry();
    if (cc && cc !== country.value) { country.value = cc; setPlaceholder(); }
  });
  phone.addEventListener("blur", () => {
    const p = parsePhone(phone.value, country.value);
    if (p) { country.value = p.country; setPlaceholder(); phone.value = parsePhoneNumberFromString(p.e164)?.formatNational() ?? phone.value; }
  });

  const data = () => {
    const fd = new FormData(form);
    const o: Record<string, unknown> = {};
    for (const k of new Set(fd.keys())) { const all = fd.getAll(k).map(String); o[k] = k === "needs" || k === "platforms" ? all : all[0]; }
    return o;
  };
  const fieldsOf = (i: number) => (steps[i]!.dataset.fields ?? "").split(" ").filter(Boolean);
  const show = (field: string, msg?: string) => {
    const err = document.getElementById(`err-${field}`);
    if (err) { err.textContent = msg ?? ""; err.hidden = !msg; }
    const el = document.getElementById(field);
    if (el) el.setAttribute("aria-invalid", msg ? "true" : "false");
    const step = steps.find((s) => fieldsOf(steps.indexOf(s)).includes(field));
    if (step && step.querySelector(`input[type=radio][name="${field}"]`)) { if (msg) step.setAttribute("data-invalid", ""); else step.removeAttribute("data-invalid"); }
  };
  const stepErrors = (i: number) => { const v = validate(data()); return v.ok ? {} : Object.fromEntries(Object.entries(v.errors).filter(([k]) => fieldsOf(i).includes(k))); };

  // Saves the answers so far once the email is valid, so a buyer who leaves halfway is not lost.
  const saveDraft = () => {
    const body = { ...data(), step: at + 1 };
    if (!isEmail(String(body.email ?? "").trim())) return;
    fetch("/api/contact-sales/draft", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body), keepalive: true }).catch(() => {});
  };

  const go = (i: number, focus = true) => {
    at = Math.max(0, Math.min(steps.length - 1, i));
    steps.forEach((s, j) => s.classList.toggle("on", j === at));
    const last = at === steps.length - 1;
    next.textContent = last ? "Send to sales" : "Continue";
    back.hidden = at === 0;
    enter.hidden = !!steps[at]!.querySelector("textarea") || "auto" in steps[at]!.dataset;
    count.textContent = `Question ${at + 1} of ${steps.length}`;
    bar.style.width = `${(at / steps.length) * 100}%`;
    status.hidden = true;
    // Text fields first (the phone number, not its country picker), then a picker, then the chosen or first option.
    const s = steps[at]!;
    const visible = (sel: string) => [...s.querySelectorAll<HTMLElement>(sel)].find((el) => !el.closest("[hidden]"));
    const first = visible("input[type=email], input[type=text], input[type=tel], textarea") ?? visible("select") ?? visible("input:checked") ?? visible("input[type=radio], input[type=checkbox]");
    if (!focus) return;
    first?.focus({ preventScroll: true });
    const top = form.closest(".cs-card")!.getBoundingClientRect().top;
    if (top < 0 || top > window.innerHeight * 0.6) form.closest(".cs-card")!.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  const advance = () => {
    const errs = stepErrors(at);
    for (const f of fieldsOf(at)) show(f, errs[f]);
    if (Object.keys(errs).length) {
      const firstBad = Object.keys(errs)[0]!;
      (document.getElementById(firstBad) ?? steps[at]!.querySelector<HTMLElement>(`input[name="${firstBad}"]`))?.focus();
      return;
    }
    saveDraft();
    if (at < steps.length - 1) go(at + 1); else submit();
  };

  // "Other" asks which tool; without JavaScript the field is always visible.
  const otherWrap = document.getElementById("other-wrap") as HTMLDivElement;
  const otherInput = document.getElementById("currentOther") as HTMLInputElement;
  const syncOther = () => { otherWrap.hidden = new FormData(form).get("current") !== "other"; };
  syncOther();
  otherWrap.querySelector("label")!.textContent = "Which one?";

  // Single-choice steps move on as soon as an answer is picked, except Other, which asks which one first.
  for (const s of steps.filter((s) => "auto" in s.dataset)) {
    s.addEventListener("change", (e) => {
      const t = e.target as HTMLInputElement;
      if (t.type !== "radio") return;
      for (const f of fieldsOf(steps.indexOf(s))) show(f);
      if (t.name === "current") { syncOther(); if (t.value === "other") { window.setTimeout(() => otherInput.focus(), 50); return; } }
      window.setTimeout(() => { if (steps[at] === s) advance(); }, 280);
    });
  }
  // Letter keys pick options (A, B, C …), like Typeform; Enter continues.
  form.addEventListener("keydown", (e) => {
    const step = steps[at]!;
    const tag = (e.target as HTMLElement).tagName;
    if (e.key === "Enter" && tag !== "TEXTAREA" && tag !== "BUTTON") { e.preventDefault(); advance(); return; }
    if (e.metaKey || e.ctrlKey || e.altKey || tag === "INPUT" && !["radio", "checkbox"].includes((e.target as HTMLInputElement).type) || tag === "TEXTAREA" || tag === "SELECT") return;
    const k = e.key.toUpperCase();
    if (k.length !== 1 || k < "A" || k > "J") return;
    const opt = step.querySelectorAll<HTMLInputElement>(".opts:not(.compact) input")[k.charCodeAt(0) - 65];
    if (opt) { e.preventDefault(); opt.click(); opt.focus(); }
  });
  back.addEventListener("click", () => go(at - 1));
  form.addEventListener("submit", (e) => { e.preventDefault(); advance(); });

  async function submit() {
    const body = data();
    const v = validate(body);
    if (!v.ok) { const i = steps.findIndex((_, j) => fieldsOf(j).some((f) => f in v.errors)); go(i); for (const [f, m] of Object.entries(v.errors)) show(f, m); return; }
    next.disabled = true; next.textContent = "Sending…";
    try {
      const r = await fetch("/api/contact-sales", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
      const out = await r.json().catch(() => ({}));
      if (r.ok && out.ok) {
        const lead = v.lead;
        // DataFast: the goal, and the email as the user id so this lead links to the signup and payment that follow.
        const df = (window as unknown as { datafast?: (...a: unknown[]) => void }).datafast;
        df?.("contact_sales_submitted", { revenue: lead.revenue, current: lead.current, next: out.next ?? "sales" });
        df?.("identify", { user_id: lead.email, name: lead.name, company: lead.company });
        bar.style.width = "100%";
        form.hidden = true;
        const done = document.getElementById("cs-done")!;
        document.getElementById("cs-done-title")!.textContent = `Thanks, ${lead.name.split(" ")[0]}. We will reply within one business day.`;
        document.getElementById("cs-done-body")!.textContent = out.next === "self_serve"
          ? `We will email ${lead.email}. Your apps fit RevenueDot Cloud, which is free up to $10,000 a month, so you can start now while you wait.`
          : `We will email ${lead.email} or call ${parsePhoneNumberFromString(lead.phone)?.formatInternational() ?? lead.phone} to set up a 30-minute call.`;
        document.getElementById("cs-done-cloud")!.hidden = out.next !== "self_serve";
        done.hidden = false; done.focus();
        return;
      }
      if (r.status === 400 && out.errors) { const i = steps.findIndex((_, j) => fieldsOf(j).some((f) => f in out.errors)); go(Math.max(0, i)); for (const [f, m] of Object.entries(out.errors as Record<string, string>)) show(f, m); }
      else { status.textContent = out.error ?? "Something went wrong. Try again, or email sales@revenuedot.app."; status.hidden = false; }
    } catch {
      status.textContent = "We could not reach the server. Check your connection and try again."; status.hidden = false;
    } finally {
      next.disabled = false; if (!form.hidden) next.textContent = "Send to sales";
    }
  }

  // DataFast goal: the form was started (first answer), so drop-off between start and send is visible.
  form.addEventListener("change", () => (window as unknown as { datafast?: (...a: unknown[]) => void }).datafast?.("contact_sales_started"), { once: true });

  go(0, false);
</script>
