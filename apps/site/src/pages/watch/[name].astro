---
// A page per tutorial video (prd/onboarding-emails/PRD.md): Stream's player, what the video shows, and the next step.
// Onboarding emails link here until the video is on YouTube.
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { playerUrl, VIDEOS, WATCH } from "../../lib/videos.mjs";

export function getStaticPaths() {
  return Object.keys(WATCH).filter((name) => VIDEOS[name]).map((name) => ({ params: { name } }));
}
const { name } = Astro.params;
const w = WATCH[name];
const v = VIDEOS[name];
const path = `/watch/${name}`;
const poster = `https://revenuedot.app/videos/${name}.webp`;
const iso = `PT${Math.floor(w.seconds / 60)}M${w.seconds % 60}S`;
const length = `${Math.floor(w.seconds / 60)}:${String(w.seconds % 60).padStart(2, "0")}`;
const jsonld = [{
  "@context": "https://schema.org", "@type": "VideoObject", name: w.heading, description: w.summary, thumbnailUrl: poster, uploadDate: w.date, duration: iso,
  contentUrl: `https://revenuedot.app/videos/${name}.mp4`, embedUrl: playerUrl(name), publisher: { "@type": "Organization", name: "RevenueDot", url: "https://revenuedot.app" },
}];
---
<Base title={w.heading} description={w.summary} path={path} image={poster} imageAlt={v.title} jsonld={jsonld}
  crumbs={[{ name: "Docs", path: "/docs" }, { name: w.heading, path }]}>
  <section class="watch">
    <div class="wrap">
      <p class="label">Video · {length}</p>
      <h1 class="h2 title">{w.heading}</h1>
      <div class="shot stream player">
        <iframe src={playerUrl(name)} title={v.title} allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
      </div>
      <div class="below">
        <p class="lede">{w.summary}</p>
        <div class="links">
          <a class="btn" href={w.next.href}>{w.next.label} <span class="arrow">→</span></a>
          {w.youtube && <a class="btn secondary" href={w.youtube} rel="noopener">Watch on YouTube</a>}
        </div>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .watch { padding: 56px 0 80px; }
  .title { margin: 12px 0 28px; max-width: 900px; text-wrap: balance; }
  .player { max-width: 1040px; }
  .below { display: grid; gap: 24px; margin-top: 28px; max-width: 760px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 720px) { .watch { padding: 32px 0 56px; } }
</style>
