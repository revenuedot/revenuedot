---
// The home page. It speaks to every app developer first: what RevenueDot does, then one door per customer case
// (company/docs/marketing/positioning.md, 2026-10-05): new to in-app purchases, already selling with your own code,
// switching from RevenueCat, building with an AI coding tool, growing revenue, keeping data on your own servers.
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import Shot from "../components/Shot.astro";
import Clip from "../components/Clip.astro";
import Faq from "../components/Faq.astro";
import TourPlayer from "../components/TourPlayer.astro";
import CtaBand from "../components/CtaBand.astro";
import { SDKS } from "../lib/sdks";
import { softwareApplication } from "../lib/jsonld";
import { cloudBill, revenueCatBill, usd, CLOUD_CAP, CLOUD_FREE_UP_TO, CLOUD_RATE } from "../lib/pricing";
import { FAQ_WHAT, FAQ_NO_RC_ACCOUNT, FAQ_COST, FAQ_STORES, FAQ_EXISTING, FAQ_NO_LOSS, FAQ_ALTERNATIVE, FAQ_OWN_SERVERS, FAQ_READY, FAQ_AFFILIATED } from "../lib/faq";
import { SITE } from "../site";
import { playerUrl, VIDEOS } from "../lib/videos.mjs";
import overviewLight from "../assets/screens/overview-light.png";
import overviewDark from "../assets/screens/overview-dark.png";
import offerings from "../assets/screens/offerings-light.png";
import { INTEGRATIONS, integrationPath, CHART_PAGES } from "../data";
import { logo } from "../lib/logos";
import { ogFor } from "../lib/og";

const faq = [FAQ_WHAT, FAQ_NO_RC_ACCOUNT, FAQ_COST, FAQ_STORES, FAQ_EXISTING, FAQ_NO_LOSS, FAQ_ALTERNATIVE, FAQ_OWN_SERVERS, FAQ_READY, FAQ_AFFILIATED];
const quick = SDKS.filter((s) => ["ios", "android", "react-native", "flutter"].includes(s.id));
const tiers = [10_000, 50_000, 250_000, 1_000_000];
const partners = INTEGRATIONS.filter((i) => !["webhooks", "data-exports"].includes(i.kind));
const wall = ["amplitude", "mixpanel", "posthog", "segment", "firebase", "bigquery", "appsflyer", "adjust", "branch", "meta-ads", "braze", "onesignal", "slack", "intercom", "zendesk", "google-admob"]
  .map((s) => partners.find((p) => p.slug === s)).filter((p) => !!p);

// One door per customer case, in the order of positioning.md. Each ends in the same free Cloud project.
const paths = [
  { href: "/add-in-app-purchases", label: "New app", title: "Adding in-app purchases for the first time", text: "Install the RevenueDot SDK, set up a plan in the dashboard and buy with the Test Store before you have a store account.", go: "Add in-app purchases" },
  { href: "/solutions/existing-apps", label: "Already selling", title: "Selling with your own code or another tool", text: "Import your products from App Store Connect, Google Play or Stripe, and stop maintaining receipt checks and store notifications yourself.", go: "Move your purchases" },
  { href: "/migrate-from-revenuecat", label: "On RevenueCat", title: "Switching from RevenueCat", text: "Keep the SDK your app already ships and change one line. Import your customers and run both side by side until the numbers match.", go: "See the switch" },
  { href: "/solutions/ai-built-apps", label: "Built with AI", title: "Building with Claude Code or Cursor", text: "Connect your coding tool to RevenueDot and paste one prompt. It creates the products and writes the purchase code for you.", go: "Use your AI tool" },
  { href: "/features", label: "Growing", title: "Growing revenue with paywalls and tests", text: `Change paywalls and prices without an app release, sell on the web with Stripe, and read ${CHART_PAGES.length} revenue charts.`, go: "See the features" },
  { href: "/self-host", label: "Own your data", title: "Keeping purchase data on your own servers", text: "Run the same open-source server on your own Postgres, in your region, with no share of your revenue.", go: "Self-host free" },
];
const resources = [
  { href: "/in-app-purchases", label: "Guide", title: "How in-app purchases work", text: "Products, subscriptions, store fees and what needs a server, on iOS, Android and the web." },
  { href: "/blog/paywall-best-practices-2026", label: "Guide", title: "Paywall best practices for 2026", text: "Hard paywalls, trial timelines, annual first and exit offers, with the data behind each." },
  { href: "/blog/subscription-app-metrics", label: "Guide", title: "Subscription metrics that matter", text: "MRR, churn, trial conversion and LTV, defined, with a chart for each." },
  { href: "/tools/app-store-fee-calculator", label: "Free tool", title: "App Store and Google Play fee calculator", text: "What you keep from each subscription after Apple's or Google's commission." },
  { href: "/glossary", label: "Reference", title: "Subscription app glossary", text: "Grace periods, offer codes, store notifications and more, in plain English." },
  { href: "/errors", label: "Reference", title: "SDK error codes", text: "Every purchases SDK error with its causes and fixes, for iOS, Android, React Native and Flutter." },
];
const features = [
  { href: "/features/paywalls", title: "Paywalls", text: "Ten templates, a visual editor and an AI generator. The SDK draws them natively, and you change them without a release." },
  { href: "/features/experiments", title: "Targeting and A/B tests", text: "Audiences, placements and price tests, with revenue per variant and the chance each one wins." },
  { href: "/features/web-billing", title: "Web checkout", text: "Sell subscriptions on the web with your own Stripe account and unlock them in the app." },
  { href: "/charts", title: `${CHART_PAGES.length} charts`, text: "MRR, churn, trial conversion, LTV, cohorts and refunds, ready from your first purchase." },
  { href: "/features/refund-control", title: "Refund Control", text: "Answer Apple's refund requests with consumption data, automatically, within the deadline." },
  { href: "/features/win-back", title: "Win-back", text: "Email campaigns and App Store win-back offers that bring churned subscribers back." },
  { href: "/features/customer-center", title: "Customer Center", text: "Cancel and refund flows with retention offers, inside your app." },
  { href: "/stores", title: "Every store", text: "App Store, Google Play, Amazon Appstore and Stripe, plus a Test Store for building before launch." },
];
const homeDescription = "Add in-app purchases and subscriptions to iOS, Android, Flutter, React Native and web apps. Open source, free until $10K a month. On RevenueCat? Change one line.";
---
<Base
  title="RevenueDot | Open-source in-app purchases and subscriptions"
  description={homeDescription}
  path="/"
  faq={faq}
  image={ogFor("/")}
  jsonld={[softwareApplication()]}
>
  <section class="hero">
    <div class="wrap">
      <a class="pill rise" href="/changelog"><span class="dot" aria-hidden="true"></span>Open source · see what shipped <span class="arrow">→</span></a>
      <h1 class="display rise d1">In-app purchases and subscriptions for every app</h1>
      <p class="lede rise d2">RevenueDot checks every purchase on the App Store, Google Play and the web, keeps each customer's access in sync, and runs your paywalls and revenue charts, free until your app makes $10,000 a month.</p>
      <div class="btns rise d3">
        <a class="btn" href={SITE.signup}>Start free</a>
        <a class="btn secondary" href="/docs/getting-started/quickstart">Read the 5-minute quickstart <span class="arrow">→</span></a>
      </div>
      <p class="small muted rise d3 alt">Already have an account? <a href={SITE.login}>Sign in</a> · Switching from RevenueCat? <a href="/migrate-from-revenuecat">Change one line</a> · Prefer your own servers? <a href="/self-host">Self-host free</a></p>
    </div>
    <div class="wrap hero-shot">
      <Shot light={overviewLight} dark={overviewDark} eager alt="RevenueDot dashboard overview: active trials, active subscriptions, MRR, revenue, new and active customers with sparklines, recent transactions and setup health" caption="The RevenueDot dashboard, captured from the running app with demo data." />
    </div>
  </section>

  <section class="section tight" aria-label="RevenueDot in numbers">
    <div class="wrap">
      <div class="grid"><div class="gi cols-4">
        <div class="cell"><p class="label">Free until</p><p class="stat">$10K</p><p>a month in tracked revenue. Above that, Cloud never costs more than {usd(CLOUD_CAP)} a month.</p></div>
        <div class="cell"><p class="label">Platforms</p><p class="stat">{SDKS.length}</p><p>iOS, Android, React Native, Flutter, the web and four more each have a RevenueDot SDK.</p></div>
        <div class="cell"><p class="label">Charts</p><p class="stat">{CHART_PAGES.length}</p><p>MRR, churn, trial conversion, LTV, cohorts and refunds, from your first purchase.</p></div>
        <div class="cell"><p class="label">Integrations</p><p class="stat">{partners.length}</p><p>Amplitude, Mixpanel, Meta, Slack and more get every purchase event.</p></div>
      </div></div>
    </div>
  </section>

  <section class="section" id="start" data-fast-scroll="viewed_home_paths">
    <div class="wrap">
      <div class="head">
        <p class="label">Where to start</p>
        <h2 class="h2">Start from where your app is today</h2>
        <p class="lede">Pick the case closest to yours. Every path ends in the same free RevenueDot Cloud project.</p>
      </div>
      <div class="grid"><div class="gi cols-3">
        {paths.map((p) => (
          <a class="cell card path" href={p.href}>
            <p class="label">{p.label}</p>
            <h3 class="h3">{p.title}</h3>
            <p>{p.text}</p>
            <span class="go-line">{p.go} <span class="arrow">→</span></span>
          </a>
        ))}
      </div></div>
    </div>
  </section>

  <section class="section" id="how" data-fast-scroll="viewed_how_it_works">
    <div class="wrap">
      <div class="head">
        <p class="label">How it works</p>
        <h2 class="h2">Install the SDK, add your key, start selling</h2>
        <p class="lede">On RevenueDot Cloud there is no server to run. You install the RevenueDot SDK, pass your app's key, and RevenueDot does the rest with Apple and Google.</p>
      </div>
      <div class="grid"><div class="gi cols-3">
        <div class="cell"><p class="num">01</p><h3 class="h3">Create a free project</h3><p>Add your app, a product such as <code>pro_monthly</code>, the access it unlocks (an entitlement such as <code>pro</code>) and the offering your paywall shows.</p></div>
        <div class="cell"><p class="num">02</p><h3 class="h3">Install the SDK</h3><p>Add the RevenueDot SDK for your platform and configure it with your app's key when the app starts.</p></div>
        <div class="cell"><p class="num">03</p><h3 class="h3">Sell and check access</h3><p>Show the offering on a paywall, buy a package, and unlock features while <code>pro</code> is active. Test it all with the Test Store first.</p></div>
      </div></div>
      <div class="sdk-grid">
        {quick.map((s) => <Code title={s.name} label={s.language} code={`${s.install}\n\n${s.configure}`} />)}
      </div>
      <p class="small muted more">The RevenueDot SDK is built from RevenueCat's open-source SDK (MIT license), so your code imports <code>RevenueCat</code> and calls <code>Purchases</code>. It sends every request to RevenueDot and needs no RevenueCat account. <a href="/sdks">All {SDKS.length} SDKs <span class="arrow">→</span></a></p>
      <div class="first">
        <div class="first-copy">
          <p class="label">Your first purchase in 78 seconds</p>
          <p class="small muted">Sign up, follow the setup checklist and make a Test Store purchase. No server and no App Store account needed. <a href="/docs/getting-started/quickstart">Follow the quickstart <span class="arrow">→</span></a></p>
        </div>
        <TourPlayer name="revenuedot-first-purchase" seconds={78} label="Watch the first purchase" location="home" />
      </div>
    </div>
  </section>

  <section class="section" id="features" data-fast-scroll="viewed_features">
    <div class="wrap">
      <div class="head">
        <p class="label">Everything in one backend</p>
        <h2 class="h2">Paywalls, experiments, web checkout and charts come with every plan</h2>
        <p class="lede">The tools subscription apps often buy separately are included, on the free plan too. <a href="/features">See every feature <span class="arrow">→</span></a></p>
      </div>
      <div class="grid"><div class="gi cols-4">
        {features.map((f) => <a class="cell card" href={f.href}><h3 class="h3">{f.title}</h3><p>{f.text}</p><span class="arrow go">→</span></a>)}
      </div></div>
    </div>
  </section>

  <section class="section" id="product">
    <div class="wrap">
      <div class="head">
        <p class="label">The dashboard</p>
        <h2 class="h2">Every customer, product and paywall is one click away</h2>
        <p class="lede">Look up any customer's purchases and access, grant or refund in a click, and change what your paywall sells without an app release.</p>
      </div>
      <div class="pair">
        <div class="pair-item">
          <Clip name="revenuedot-loop-customers-v1" alt="The Customers list in RevenueDot with its filters, then one customer's page: the app user ID, the active entitlement and App Store subscription, details and history" sizes="(max-width: 900px) 100vw, 600px" />
          <p class="small"><strong>Customers.</strong> <span class="muted">Every purchase, entitlement, alias and event for one app user, with grants and refunds a click away.</span></p>
        </div>
        <div class="pair-item">
          <Shot light={offerings} alt="The Offerings page in RevenueDot: default and win-back offerings with their packages" sizes="(max-width: 900px) 100vw, 600px" />
          <p class="small"><strong>Product catalog.</strong> <span class="muted">Offerings, packages, products and entitlements. Change the current offering and every app shows it on the next launch.</span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="demo" data-fast-scroll="viewed_platform_demo">
    <div class="wrap">
      <div class="head">
        <p class="label">See the whole platform in 2½ minutes</p>
        <h2 class="h2">One dashboard runs charts, paywalls, experiments and integrations</h2>
        <p class="lede">The tour starts with an app moving from RevenueCat, then opens every part of the dashboard: charts, customers, paywalls, experiments, win-back, integrations and the AI assistant. Use the chapters to jump to the part you need.</p>
      </div>
      <TourPlayer name="revenuedot-platform-demo" seconds={152} location="home" />
    </div>
  </section>

  <section class="section" id="integrations" data-fast-scroll="viewed_integrations">
    <div class="wrap">
      <div class="head">
        <p class="label">Integrations</p>
        <h2 class="h2">Every purchase event reaches the tools you already use</h2>
        <p class="lede">{partners.length} integrations get every purchase, renewal, trial, cancellation and refund, on every plan. <a href="/integrations">All integrations <span class="arrow">→</span></a></p>
      </div>
      <div class="wall">
        {wall.map((p) => <a href={integrationPath(p)} class="logo-tile" title={p.name}><img src={logo(p.logo)} alt={p.name} width="52" height="52" loading="lazy" decoding="async" /><span>{p.name}</span></a>)}
      </div>
    </div>
  </section>

  <section class="section" id="chat">
    <div class="wrap">
      <div class="head">
        <p class="label">In ChatGPT and Claude</p>
        <h2 class="h2">Run your subscriptions by asking in chat</h2>
        <p class="lede">Connect RevenueDot to ChatGPT or Claude, then check revenue, find a customer, grant access or fix a webhook in plain words. It asks before changing anything, never moves money without your approval, and never takes your store keys.</p>
      </div>
      <div class="shot stream">
        <iframe src={playerUrl("revenuedot-chatgpt-demo")} title={VIDEOS["revenuedot-chatgpt-demo"].title} loading="lazy" allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
      </div>
      <p class="small more"><a href="/docs/guides/connect-ai-assistants">Connect ChatGPT, Claude or Cursor</a> <span class="muted">in about a minute with one URL.</span></p>
    </div>
  </section>

  <section class="section" id="switch" data-fast-scroll="viewed_home_switch">
    <div class="wrap">
      <div class="head">
        <p class="label">Switching from RevenueCat</p>
        <h2 class="h2">Apps on RevenueCat keep their SDK and change one line</h2>
        <p class="lede">RevenueDot answers the calls the RevenueCat SDK makes, in the same format, so your purchase code, paywalls and backend webhook handlers keep working. Most teams move in an afternoon without losing a subscriber.</p>
      </div>
      <div class="grid"><div class="gi cols-3">
        <div class="cell"><p class="num">01</p><h3 class="h3">Import</h3><p>One command copies your products, entitlements, offerings, SDK keys, customers and purchase history. Current access comes with it.</p></div>
        <div class="cell"><p class="num">02</p><h3 class="h3">Run side by side</h3><p>Point App Store and Google Play notifications at RevenueDot. It forwards each one to RevenueCat, so both stay accurate while you compare.</p></div>
        <div class="cell"><p class="num">03</p><h3 class="h3">Switch</h3><p>Ship an app update with the one line below. When most users have it, turn RevenueCat off. Your existing public API keys keep working.</p></div>
      </div></div>
      <div class="sdk-grid">
        {quick.map((s) => <Code title={`${s.name}: the one line`} label={s.language} code={s.proxy} />)}
      </div>
      <p class="small muted more"><a href="/migrate-from-revenuecat">See the line for every SDK, the importer and the side-by-side run <span class="arrow">→</span></a></p>
    </div>
  </section>

  <section class="section" id="cost" data-fast-scroll="viewed_cost_comparison">
    <div class="wrap">
      <div class="head">
        <p class="label">What it costs</p>
        <h2 class="h2">Free until {usd(CLOUD_FREE_UP_TO)} a month, then never more than {usd(CLOUD_CAP)}</h2>
        <p class="lede">Tracked revenue is your store revenue before Apple and Google take their cut. Above {usd(CLOUD_FREE_UP_TO)} a month, Cloud Standard charges {CLOUD_RATE * 100}% of the revenue above it. Self-hosting costs only your servers. RevenueCat's price, from its public pricing checked {SITE.pricesChecked}, is shown for comparison.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Monthly tracked revenue</th><th scope="col">RevenueDot Cloud</th><th scope="col">RevenueDot self-hosted</th><th scope="col">RevenueCat</th></tr></thead>
          <tbody>
            {tiers.map((t) => (
              <tr>
                <th scope="row" class="num-cell">{usd(t)}</th>
                <td class="num-cell">{usd(cloudBill(t))}</td>
                <td class="num-cell">$0 + your servers</td>
                <td class="num-cell">{usd(revenueCatBill(t))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tiny caption">RevenueCat source: <a href="https://www.revenuecat.com/pricing" rel="noopener">revenuecat.com/pricing</a>. <a href="/pricing">See pricing</a> · <a href="/tools/revenuecat-fee-calculator">Compare your own bill</a>.</p>
    </div>
  </section>

  <section class="section" id="resources">
    <div class="wrap">
      <div class="head">
        <p class="label">Guides and free tools</p>
        <h2 class="h2">Answers for subscription app developers</h2>
      </div>
      <div class="grid"><div class="gi cols-3">
        {resources.map((r) => <a class="cell card" href={r.href}><p class="label">{r.label}</p><h3 class="h3">{r.title}</h3><p>{r.text}</p><span class="arrow go">→</span></a>)}
      </div></div>
    </div>
  </section>

  <section class="section" id="faq" data-fast-scroll="viewed_faq">
    <div class="wrap">
      <div class="head">
        <p class="label">FAQ</p>
        <h2 class="h2">Answers to the questions developers ask first</h2>
      </div>
      <Faq items={faq} open={0} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .alt { margin-top: 14px; }
  .alt a { color: var(--fg); }
  .hero { padding: 72px 0 0; }
  .hero .wrap:first-child { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; justify-items: start; }
  .hero h1 { max-width: 1120px; text-wrap: balance; }
  .h2 { text-wrap: balance; }
  .hero-shot { margin-top: 56px; margin-bottom: 96px; }
  .path { text-decoration: none; transition: background var(--fast) var(--ease); grid-template-rows: auto auto 1fr auto; }
  .path:hover { background: var(--hover); }
  .path .h3 { font-size: 18px; }
  .go-line { font-size: 13px; font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg); margin-top: 6px; }
  .sdk-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 32px; }
  .sdk-grid :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .more { margin-top: 20px; max-width: 860px; }
  .more a { color: var(--fg); }
  .first { margin-top: 48px; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px; align-items: center; }
  .first-copy { display: grid; gap: 10px; }
  .first-copy a { color: var(--fg); }
  .lede a { color: var(--fg); }
  .card { text-decoration: none; transition: background var(--fast) var(--ease); }
  .card:hover { background: var(--hover); }
  .go { color: var(--fg-3); }
  .wall { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); border: 1px solid var(--border); background: var(--panel); }
  .logo-tile { display: grid; justify-items: center; gap: 10px; padding: 22px 8px; border-right: 1px solid var(--border-2); border-bottom: 1px solid var(--border-2); text-decoration: none; font-size: 12px; font-weight: 600; color: var(--fg-2); transition: background var(--fast) var(--ease); }
  .logo-tile:hover { background: var(--hover); color: var(--fg); }
  .logo-tile img { width: 52px; height: 52px; padding: 8px; object-fit: contain; background: #FFFFFF; border: 1px solid var(--border); }
  @media (max-width: 900px) { .wall { grid-template-columns: repeat(4, minmax(0, 1fr)); } .first { grid-template-columns: minmax(0, 1fr); gap: 16px; } }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .pair-item { display: grid; gap: 16px; align-content: start; }
  @media (max-width: 900px) { .pair, .sdk-grid { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .hero { padding-top: 40px; } .hero-shot { margin: 40px auto 64px; } }
</style>
