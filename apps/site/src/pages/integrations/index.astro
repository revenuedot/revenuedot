---
import Hub from "../../templates/Hub.astro";
import { INTEGRATIONS, INTEGRATION_CATEGORIES, integrationPath } from "../../data";
import { logo } from "../../lib/logos";
const order = ["Webhooks and data", "Product analytics", "Attribution and ads measurement", "Messaging and marketing", "Customer support", "Ad monetization"];
const groups = order
  .map((title) => ({
    title,
    cards: INTEGRATIONS.filter((i) => (INTEGRATION_CATEGORIES[i.category] ?? i.category) === title)
      .map((i) => ({ href: integrationPath(i), title: i.name, text: i.card, logo: logo(i.logo) })),
  }))
  .filter((g) => g.cards.length);
const partners = INTEGRATIONS.filter((i) => !["webhooks", "data-exports"].includes(i.kind)).length;
const faq = [
  { q: "Which integrations does RevenueDot support?", a: `RevenueDot sends subscription events to ${partners} tools, including Amplitude, Mixpanel, PostHog, Segment, Firebase, BigQuery, AppsFlyer, Adjust, Branch, Meta, Braze, OneSignal, Slack, Intercom and Zendesk, plus webhooks to your own backend and scheduled exports to S3, R2 and Google Cloud Storage.` },
  { q: "Are RevenueDot integrations compatible with RevenueCat's?", a: "Yes. Integrations get the same events webhooks get, with RevenueCat's event names and reserved attributes, so dashboards and pipelines built on RevenueCat's integrations keep working after you switch." },
  { q: "Do integrations cost extra?", a: "No. Every integration is included on RevenueDot Cloud, which is free up to $10,000 a month in tracked revenue, then 0.5%, never more than $999 a month." },
  { q: "What happens when a partner's API is down?", a: "RevenueDot retries on the webhook schedule and keeps a delivery log with the scrubbed request, the partner's answer and the reason for any skip. You can retry or replay events from the dashboard." },
];
---
<Hub path="/integrations" name="Integrations" label="Integrations" cols={4}
  title={`Integrations: send subscription events to ${partners} tools`}
  metaTitle="Integrations for in-app subscription events"
  description={`Send App Store, Google Play and Stripe subscription events to ${partners} analytics, attribution, messaging and support tools, plus webhooks and data exports.`}
  answer={`RevenueDot sends every purchase, renewal, trial, cancellation and refund to **${partners} tools**, such as Amplitude, Mixpanel, AppsFlyer, Braze and Slack. It also sends signed **webhooks** to your backend and scheduled **data exports** to your bucket. Every integration is included on every plan. Moving from RevenueCat? Events keep RevenueCat's names and attributes, so existing dashboards keep working.`}
  groups={groups} faq={faq} />
