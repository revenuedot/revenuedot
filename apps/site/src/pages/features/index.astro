---
import Hub from "../../templates/Hub.astro";
import { LANDINGS, landingPath } from "../../data";
import { platformLogo } from "../../lib/platform-logos";
const cards = LANDINGS.filter((l) => l.section === "features").map((l) => ({ href: landingPath(l), title: l.name, text: l.card, logo: platformLogo(l.slug) }));
---
<Hub path="/features" name="Features" label="Features" title={"Everything RevenueDot does for subscription apps"} metaTitle={"Features: in-app purchase backend, paywalls, web checkout"}
  description={"Purchase checks, entitlements, paywalls, experiments, web checkout, 43 charts, win-back and 36 integrations for subscription apps. Open source, free to start."}
  answer={"RevenueDot is an open-source backend for in-app purchases and subscriptions. It checks every App Store, Google Play, Amazon and Stripe purchase, keeps each customer's access current, and adds paywalls, A/B tests, web checkout, 43 charts and lifecycle tools on top. Cloud is free until your app makes $10,000 a month. Switching from RevenueCat takes one line."}
  groups={[{ title: "All features", cards }]} video="revenuedot-dashboard-tour" />
