{
  "name": "@revenuedot/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "REVENUEDOT_ALLOW_SIGNUP=${REVENUEDOT_ALLOW_SIGNUP:-true} REVENUEDOT_SHUTDOWN_DELAY_MS=${REVENUEDOT_SHUTDOWN_DELAY_MS:-0} tsx watch src/entry.node.ts",
    "start": "tsx src/entry.node.ts",
    "dev:worker": "cf dev",
    "build:worker": "cf build",
    "migrate": "tsx src/migrate.node.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.41",
    "@ai-sdk/gateway": "4.0.48",
    "@ai-sdk/openai": "4.0.46",
    "@ai-sdk/provider": "4.0.7",
    "@cloudflare/ai-chat": "0.12.0",
    "@hono/node-server": "^1.13.7",
    "@revenuedot/core": "workspace:*",
    "@revenuedot/db": "workspace:*",
    "agents": "0.24.0",
    "ai": "7.0.60",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "hyparquet-writer": "0.16.10",
    "jose": "^5.9.6",
    "nodemailer": "^10.0.13",
    "revenuedot": "workspace:*",
    "workers-ai-provider": "4.0.0",
    "zod": "^3.25.76"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "cf": "1.0.0-beta.5",
    "hyparquet": "1.31.1",
    "smtp-server": "^3.19.16",
    "vite": "^8.3.1"
  }
}
