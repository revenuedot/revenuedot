// RevenueDot Cloud on Cloudflare Workers. Steps and inputs: docs/cloud.md. Deploy with `pnpm deploy:cloud` from the repo root.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revenuedot",
  "main": "src/entry.worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Postgres through Hyperdrive. Replace the id with the output of `wrangler hyperdrive create revenuedot --connection-string=...`.
  // `wrangler dev` connects to CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE when set (use the Railway dev
  // database, see docs/cloud.md), else to localConnectionString. Never put a real connection string in this file.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://revenuedot:revenuedot@localhost:5432/revenuedot"
    }
  ],
  // The dashboard build. The worker answers the API paths itself and hands everything else to ASSETS, which falls back
  // to index.html for the single-page app's routes.
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // The one periodic job: expirations, Google voided purchases, webhook deliveries.
  "triggers": { "crons": ["* * * * *"] },
  // One worker serves both hostnames: api.revenuedot.app is all API, app.revenuedot.app is the dashboard plus same-origin API calls.
  // Keep app.revenuedot.app first: `wrangler dev` rewrites request URLs to the first route's host, and that host serves both.
  "routes": [
    { "pattern": "app.revenuedot.app", "custom_domain": true },
    { "pattern": "api.revenuedot.app", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Secrets (set with `wrangler secret put`, never in this file):
  //   REVENUEDOT_SIGNING_KEY  base64 Ed25519 seed for response signing (Trusted Entitlements)
}
