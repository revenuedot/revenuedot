# RevenueDot self-host configuration: the one file to edit. Copy it to .env next to docker-compose.yml.
# docker compose reads it on `docker compose up -d`; upgrades (`git pull && docker compose up -d --build`) keep it,
# and the server applies any new database migrations by itself when it starts.

# Password of the bundled Postgres. Set it once before the first start.
POSTGRES_PASSWORD=change-me

# Host port for the API and dashboard (http://localhost:8787 by default).
# REVENUEDOT_PORT=8787

# Sign-up: only the first account (the owner) can sign up on a self-hosted server. Set to true to let anyone who can
# reach the dashboard create an account (and then approve MCP clients for their own projects).
# REVENUEDOT_ALLOW_SIGNUP=false

# Local development without Docker: point the server at any Postgres (unset uses an on-disk PGlite in .data/dev).
# DATABASE_URL=postgres://revenuedot:change-me@localhost:5432/revenuedot
# PORT=8787
