# RevenueDot self-host configuration: the one file to edit. Copy it to .env next to docker-compose.yml.
# docker compose reads it on `docker compose up -d`; upgrades (`docker compose pull && docker compose up -d`) keep it,
# and the server applies any new database migrations by itself when it starts.

# Password of the bundled Postgres. Set it once before the first start.
POSTGRES_PASSWORD=change-me

# Host port for the API and dashboard (http://localhost:8787 by default).
# REVENUEDOT_PORT=8787

# The server image: ghcr.io/revenuedot/revenuedot, built for amd64 and arm64 on every change. `latest` by default;
# pin a date tag (2026.10.03) or a commit tag so a restart never picks up a newer build than you tested.
# REVENUEDOT_IMAGE=ghcr.io/revenuedot/revenuedot:latest

# Sign-up: only the first account (the owner) can sign up on a self-hosted server. Set to true to let anyone who can
# reach the dashboard create an account (and then approve MCP clients for their own projects).
# REVENUEDOT_ALLOW_SIGNUP=false

# Trusted Entitlements: a base64 Ed25519 seed that signs SDK responses so the RevenueCat SDK can verify them.
# Generate one with `pnpm tsx scripts/signing-keygen.ts`, which also prints the public key the app verifies with
# (served at /.well-known/revenuedot-signing-key). Empty or unset leaves signing off.
# REVENUEDOT_SIGNING_KEY=

# Integrations and data exports (Slack, Segment, Amplitude, S3 ...): their API keys and tokens are sealed with AES-256-GCM
# using this key, the base64 of 32 random bytes (`openssl rand -base64 32`). Unset: a key derived from
# REVENUEDOT_SIGNING_KEY is used; with neither, the credentials are stored unencrypted (still never shown by the API).
# Keep it: changing it means entering the integrations' keys again. Setting it later is safe: what was sealed with the
# key derived from REVENUEDOT_SIGNING_KEY stays readable while that signing key is unchanged.
# REVENUEDOT_ENCRYPTION_KEY=

# Email: password resets, team invites, email verification links and alerts (failing store notifications, webhooks,
# store credentials). Without REVENUEDOT_SMTP_URL nothing is sent: every email, links included, is printed to the
# server log (`docker compose logs revenuedot`). Any SMTP provider works: smtp:// uses STARTTLS on port 587,
# smtps:// uses TLS on port 465. Put special characters in the user or password URL-encoded.
# REVENUEDOT_SMTP_URL=smtp://user:password@smtp.example.com:587
# REVENUEDOT_MAIL_FROM=RevenueDot <no-reply@example.com>
# REVENUEDOT_MAIL_REPLY_TO=team@example.com
# The address people use to open the dashboard, for links in emails (e.g. https://revenuedot.example.com). Unset: the
# address the request came in on.
# REVENUEDOT_PUBLIC_URL=
# The address your apps use for the API, when it differs from the dashboard's (paywall images and icons are served from it).
# REVENUEDOT_API_URL=
# Optional: a Google Cloud OAuth client (Web application) for "Connect AdMob" (Ads). Add the redirect URI
# <your API origin>/v1/ads/admob/oauth/callback in Google Cloud. Without it each project can enter its own client.
# REVENUEDOT_GOOGLE_OAUTH_CLIENT_ID=
# REVENUEDOT_GOOGLE_OAUTH_CLIENT_SECRET=
# Hosted web pages (purchase links, funnels, redemption links) live at <this server>/pay unless this is set, for example
# https://pay.yourcompany.com (pages at the root of that host). Custom domains must CNAME to REVENUEDOT_CUSTOM_DOMAIN_TARGET,
# else to the pay host.
# REVENUEDOT_PAY_URL=
# REVENUEDOT_CUSTOM_DOMAIN_TARGET=
# Cloudflare for SaaS, only when this server sits behind Cloudflare and serves customers' domains: the zone id and a token
# with "SSL and Certificates: Edit" on it. Verified Metrics custom domains then get their certificates automatically.
# REVENUEDOT_CF_SAAS_ZONE_ID=
# REVENUEDOT_CF_SAAS_API_TOKEN=

# "Generate with AI" on paywalls: one of these keys turns it on (off without them), tried in this order.
# AI_GATEWAY_API_KEY: Vercel AI Gateway (https://vercel.com/ai-gateway), model openai/gpt-6-luna with medium reasoning.
#   Recommended: with it every AI feature (paywalls, funnels, RevenueDot AI, insights) uses that one model.
# OPENAI_API_KEY: OpenAI directly, model gpt-6-luna; OPENAI_BASE_URL points it at any OpenAI-compatible server.
# ANTHROPIC_API_KEY: Anthropic, model claude-sonnet-4-5.
# REVENUEDOT_PAYWALL_MODEL picks another model (with the gateway only a gateway id such as openai/gpt-6-sol counts).
# REVENUEDOT_AI_REASONING sets the reasoning effort of OpenAI reasoning models for every AI feature (none, low, medium,
# high; default medium with the gateway, low with OPENAI_API_KEY); REVENUEDOT_PAYWALL_REASONING overrides it for
# paywalls and funnels.
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REVENUEDOT_PAYWALL_MODEL=
# REVENUEDOT_AI_REASONING=
# REVENUEDOT_PAYWALL_REASONING=
# OPENAI_BASE_URL=
# The same keys turn on RevenueDot AI, the assistant in the dashboard (docs: guides/revenuedot-ai). It uses the strongest
# tool-calling model: openai/gpt-6-luna with AI_GATEWAY_API_KEY (tried first), claude-opus-5-5 with
# ANTHROPIC_API_KEY, gpt-6-astra with OPENAI_API_KEY.
# REVENUEDOT_ASSISTANT_MODEL picks another model; REVENUEDOT_ASSISTANT_CAPS sets daily caps as JSON, for example
# {"userTurnsPerDay": 200, "projectTurnsPerDay": 600, "userTokensPerDay": 2000000}.
# REVENUEDOT_ASSISTANT_MODEL=
# REVENUEDOT_ASSISTANT_CAPS=
# The weekly AI growth insights digest (docs: guides/growth-insights): every Monday from 06:00 UTC, RevenueDot AI writes
# 3 to 5 recommendations per project with revenue and emails them to its admins. It spends your model key, so it is
# off unless set to "on". The Overview's Growth insights panel works either way (Refresh writes them on demand).
# REVENUEDOT_INSIGHTS_DIGEST=on

# Full exports and moves (docs: guides/move-projects). Archives go to this folder (default .data/archives; the Docker
# image keeps them on the "archives" volume at /data/archives), or "db" to keep them in Postgres. With
# REVENUEDOT_ARCHIVE_S3_BUCKET set they go to an S3-compatible bucket instead (AWS S3, Cloudflare R2, MinIO).
# REVENUEDOT_ARCHIVE_DIR=
# REVENUEDOT_ARCHIVE_S3_BUCKET=
# REVENUEDOT_ARCHIVE_S3_REGION=
# REVENUEDOT_ARCHIVE_S3_ENDPOINT=
# REVENUEDOT_ARCHIVE_S3_ACCESS_KEY_ID=
# REVENUEDOT_ARCHIVE_S3_SECRET_ACCESS_KEY=
# REVENUEDOT_ARCHIVE_S3_PREFIX=

# Tests only: REVENUEDOT_EDITION=cloud runs this server as RevenueDot Cloud (open sign-up, Cloud billing with the
# REVENUEDOT_BILLING_* settings in prd/cloud-billing/PRD.md). Self-hosted servers leave it unset: no billing, no limits.
# REVENUEDOT_EDITION=

# Local development without Docker: point the server at any Postgres (unset uses an on-disk PGlite in .data/dev).
# DATABASE_URL=postgres://revenuedot:change-me@localhost:5432/revenuedot
# PORT=8787

# Several replicas on one Postgres (docs: guides/high-availability; Helm chart and Terraform in deploy/). Each replica
# migrates on start under a Postgres lock unless REVENUEDOT_MIGRATE=skip (a separate migration job runs
# `node --import tsx src/migrate.node.ts`). The background job runs on one replica at a time; REVENUEDOT_BACKGROUND_JOBS=off
# keeps a replica to requests. On SIGTERM a replica answers /readyz with 503, waits REVENUEDOT_SHUTDOWN_DELAY_MS, then
# drains for up to REVENUEDOT_SHUTDOWN_TIMEOUT_MS. DATABASE_POOL_MAX is connections per replica (at least 2).
# REVENUEDOT_TICK_LOG=1 logs each background job run; REVENUEDOT_REPLICA_ID names this replica in logs (default host:pid).
# REVENUEDOT_MIGRATE=auto
# REVENUEDOT_BACKGROUND_JOBS=on
# REVENUEDOT_TICK_INTERVAL_MS=30000
# REVENUEDOT_SHUTDOWN_DELAY_MS=5000
# REVENUEDOT_SHUTDOWN_TIMEOUT_MS=20000
# DATABASE_POOL_MAX=10
# REVENUEDOT_TICK_LOG=
# REVENUEDOT_REPLICA_ID=

# Debugging: write one JSON line per request (method, path, status; no bodies or headers) to this file. The device
# test harnesses use it to check each SDK call.
# REVENUEDOT_REQUEST_LOG=/tmp/revenuedot-requests.jsonl
